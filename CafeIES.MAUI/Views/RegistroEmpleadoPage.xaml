<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             x:Class="CafeIES.MAUI.Views.RegistroEmpleadoPage"
             x:DataType="vm:RegistroEmpleadoViewModel"
             BackgroundColor="{StaticResource BgColor}">
    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
                                         EventName="Appearing" Command="{Binding CargarInstitutosCommand}"/>
    </ContentPage.Behaviors>
    <ScrollView>
        <VerticalStackLayout Padding="32,24" Spacing="0">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,28">
                <Border Grid.Column="0" BackgroundColor="{StaticResource Surface2Color}"
                        StrokeThickness="1" Stroke="{StaticResource BorderColor}"
                        WidthRequest="38" HeightRequest="38" Margin="0,0,12,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Label Text="←" TextColor="{StaticResource TextColor}" FontSize="18"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VolverCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Crear cuenta" FontFamily="SyneBold" FontSize="26" TextColor="{StaticResource TextColor}"/>
                    <Label Text="Empleado de cafetería" Style="{StaticResource SubtitleLabel}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Nombre -->
            <Label Text="NOMBRE COMPLETO" FontFamily="SyneBold" FontSize="11" TextColor="{StaticResource MutedColor}" CharacterSpacing="2" Margin="0,0,0,8"/>
            <Border StrokeThickness="1.5" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface2Color}" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Entry Style="{StaticResource InputEntry}" Text="{Binding NombreCompleto}" Placeholder="ej. María López"/>
            </Border>

            <!-- Email -->
            <Label Text="CORREO ELECTRÓNICO" FontFamily="SyneBold" FontSize="11" TextColor="{StaticResource MutedColor}" CharacterSpacing="2" Margin="0,16,0,8"/>
            <Border StrokeThickness="1.5" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface2Color}" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Entry Style="{StaticResource InputEntry}" Text="{Binding Email}" Placeholder="empleado@ies.edu" Keyboard="Email"/>
            </Border>

            <!-- Password -->
            <Label Text="CONTRASEÑA" FontFamily="SyneBold" FontSize="11" TextColor="{StaticResource MutedColor}" CharacterSpacing="2" Margin="0,16,0,8"/>
            <Border StrokeThickness="1.5" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface2Color}" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Entry Style="{StaticResource InputEntry}" Text="{Binding Password}" Placeholder="Mínimo 8 caracteres" IsPassword="True"/>
            </Border>

            <!-- Confirmar contraseña -->
            <Label Text="CONFIRMAR CONTRASEÑA" FontFamily="SyneBold" FontSize="11" TextColor="{StaticResource MutedColor}" CharacterSpacing="2" Margin="0,16,0,8"/>
            <Border StrokeThickness="1.5" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface2Color}" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Entry Style="{StaticResource InputEntry}" Text="{Binding ConfirmarPassword}" Placeholder="Repite la contraseña" IsPassword="True"/>
            </Border>

            <!-- Instituto -->
            <Label Text="INSTITUTO" FontFamily="SyneBold" FontSize="11" TextColor="{StaticResource MutedColor}" CharacterSpacing="2" Margin="0,20,0,8"/>
            <Border StrokeThickness="1.5" Stroke="{StaticResource BorderColor}" BackgroundColor="{StaticResource Surface2Color}" Padding="4,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Picker ItemsSource="{Binding Institutos}" ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding InstitutoSeleccionado}"
                        Title="Selecciona tu instituto"
                        TextColor="{StaticResource TextColor}" TitleColor="{StaticResource MutedColor}"
                        FontFamily="DMSans" FontSize="15" HorizontalOptions="FillAndExpand"/>
            </Border>

            <!-- Error -->
            <Border BackgroundColor="#26e05252" StrokeThickness="1" Stroke="#40e05252"
                    Padding="14,10" Margin="0,16,0,0" IsVisible="{Binding HayError}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource RedColor}" FontFamily="DMSans" FontSize="13"/>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource AccentColor}" Margin="0,12" IsVisible="{Binding IsLoading}"/>

            <Button Text="Registrarme →" Style="{StaticResource PrimaryButton}" Command="{Binding RegistrarCommand}" Margin="0,28,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
