<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CafeIES.MAUI.Views.DetallePedidoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
    xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
    x:DataType="vm:DetallePedidoViewModel"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,16,24,40" Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,24">
                <Button Grid.Column="0"
                        Text="←"
                        Command="{Binding VolverCommand}"
                        Style="{StaticResource BtnOutline}"
                        WidthRequest="44" HeightRequest="44"
                        Padding="0"/>
                <Label Grid.Column="1"
                       Style="{StaticResource H2}"
                       Margin="12,0,0,0"
                       VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Pedido "/>
                            <Span Text="{Binding NumeroPedido, StringFormat='#{0}'}"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </Grid>

            <!-- Estado visual -->
            <Border Style="{StaticResource SurfaceCard}" Padding="20" Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*">

                    <!-- Icono de estado grande -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{Binding EstadoEmoji}"
                           FontSize="44"
                           VerticalOptions="Center"
                           Margin="0,0,16,0"/>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding EstadoTexto}"
                               Style="{StaticResource H3}"
                               TextColor="{Binding EstadoColor}"/>
                        <Label Text="{Binding EstadoDescripcion}"
                               Style="{StaticResource Caption}"
                               Margin="0,4,0,0"/>
                    </VerticalStackLayout>

                    <!-- Barra de progreso de estado -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="2"
                          ColumnDefinitions="*,*,*,*"
                          Margin="0,20,0,0">
                        <BoxView Grid.Column="0"
                                 HeightRequest="4" CornerRadius="2"
                                 BackgroundColor="{StaticResource AccentColor}"/>
                        <BoxView Grid.Column="1"
                                 HeightRequest="4" CornerRadius="2"
                                 BackgroundColor="{Binding Paso2Color}"/>
                        <BoxView Grid.Column="2"
                                 HeightRequest="4" CornerRadius="2"
                                 BackgroundColor="{Binding Paso3Color}"
                                 Margin="2,0"/>
                        <BoxView Grid.Column="3"
                                 HeightRequest="4" CornerRadius="2"
                                 BackgroundColor="{Binding Paso4Color}"
                                 Margin="2,0,0,0"/>
                    </Grid>

                    <Grid Grid.Row="2" Grid.ColumnSpan="2"
                          ColumnDefinitions="*,*,*,*"
                          Margin="0,6,0,0">
                        <Label Grid.Column="0" Text="Recibido"  Style="{StaticResource Caption}" HorizontalOptions="Center" FontSize="9"/>
                        <Label Grid.Column="1" Text="En prep."  Style="{StaticResource Caption}" HorizontalOptions="Center" FontSize="9"/>
                        <Label Grid.Column="2" Text="Listo"     Style="{StaticResource Caption}" HorizontalOptions="Center" FontSize="9"/>
                        <Label Grid.Column="3" Text="Recogido"  Style="{StaticResource Caption}" HorizontalOptions="Center" FontSize="9"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- Líneas del pedido -->
            <Label Text="PRODUCTOS" Style="{StaticResource Caption}"
                   FontFamily="SyneBold" CharacterSpacing="1.2"
                   Margin="0,0,0,10"/>

            <Border Style="{StaticResource SurfaceCard}" Padding="0" Margin="0,0,0,16">
                <CollectionView ItemsSource="{Binding Lineas}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:LineaPedidoDto">
                            <Grid ColumnDefinitions="*,Auto"
                                  Padding="16,14"
                                  RowDefinitions="Auto">
                                <VerticalStackLayout Grid.Column="0">
                                    <Label Text="{Binding ProductoNombre}"
                                           FontFamily="SyneBold" FontSize="14"
                                           TextColor="{DynamicResource TextColor}"/>
                                    <Label FontSize="12" TextColor="{DynamicResource MutedColor}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Cantidad}"/>
                                                <Span Text=" × "/>
                                                <Span Text="{Binding PrecioUnitario, StringFormat='{0:0.00}€'}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Notas}"
                                           FontFamily="DMSans" FontSize="11"
                                           TextColor="{DynamicResource MutedColor}"
                                           FontAttributes="Italic"
                                           IsVisible="{Binding Notas, Converter={StaticResource StringNotNullOrEmptyConverter}}"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding Subtotal, StringFormat='{0:0.00}€'}"
                                       FontFamily="SyneBold" FontSize="15"
                                       TextColor="{StaticResource AccentColor}"
                                       VerticalOptions="Center"/>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>

            <!-- Total -->
            <Border Style="{StaticResource SurfaceCard}" Padding="16,14" Margin="0,0,0,24">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0" Text="Total pagado"
                           FontFamily="SyneBold" FontSize="15"/>
                    <Label Grid.Column="1"
                           Text="{Binding Total, StringFormat='{0:0.00}€'}"
                           FontFamily="SyneBold" FontSize="18"
                           TextColor="{StaticResource AccentColor}"/>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
