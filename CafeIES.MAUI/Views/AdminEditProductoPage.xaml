<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.AdminEditProductoPage"
             x:DataType="vm:AdminEditProductoViewModel"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.Resources>
        <toolkit:BoolToObjectConverter x:Key="IsSavingToText"
                                       TrueObject="Guardando..."
                                       FalseObject="Guardar producto"/>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceColor}"
              Padding="16,14" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Text="Volver"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" Padding="12,0"
                    Command="{Binding CancelarCommand}"/>
            <Label Grid.Column="1"
                   Text="{Binding Titulo}"
                   FontFamily="SyneBold" FontSize="20"
                   TextColor="{StaticResource TextColor}"
                   Margin="12,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,20" Spacing="18">

                <!-- Nombre -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nombre"
                           FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource MutedColor}"/>
                    <Border BackgroundColor="{StaticResource Surface2Color}"
                            StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Entry Style="{StaticResource InputEntry}"
                               Text="{Binding Nombre}"
                               Placeholder="ej. Bocadillo Mixto"
                               Margin="4,0"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Descripcion -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Descripcion (opcional)"
                           FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource MutedColor}"/>
                    <Border BackgroundColor="{StaticResource Surface2Color}"
                            StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Entry Style="{StaticResource InputEntry}"
                               Text="{Binding Descripcion}"
                               Placeholder="Breve descripcion"
                               Margin="4,0"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Precio y Stock -->
                <Grid ColumnDefinitions="*,16,*">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="Precio (EUR)"
                               FontFamily="SyneBold" FontSize="13"
                               TextColor="{StaticResource MutedColor}"/>
                        <Border BackgroundColor="{StaticResource Surface2Color}"
                                StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Entry Style="{StaticResource InputEntry}"
                                   Text="{Binding Precio}"
                                   Keyboard="Numeric" Placeholder="0.00"
                                   Margin="4,0"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="6">
                        <Label Text="Stock (-1 = ilimitado)"
                               FontFamily="SyneBold" FontSize="13"
                               TextColor="{StaticResource MutedColor}"/>
                        <Border BackgroundColor="{StaticResource Surface2Color}"
                                StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Entry Style="{StaticResource InputEntry}"
                                   Text="{Binding Stock}"
                                   Keyboard="Numeric" Placeholder="-1"
                                   Margin="4,0"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Imagen -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Imagen del producto"
                           FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource MutedColor}"/>
                    <Grid ColumnDefinitions="80,*" ColumnSpacing="14">
                        <!-- Preview -->
                        <Border Grid.Column="0"
                                WidthRequest="72" HeightRequest="72"
                                BackgroundColor="{StaticResource Surface2Color}"
                                StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <!-- Imagen cargada -->
                            <Image Source="{Binding ImagenUrl}"
                                   Aspect="AspectFill"
                                   IsVisible="{Binding TieneImagen}"/>
                            <!-- Placeholder sin imagen -->
                            <Label Text="📷" FontSize="30"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding TieneImagen, Converter={StaticResource InvertBoolConverter}}"/>
                        </Border>
                        <!-- Botón seleccionar -->
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Grid>
                                <Button Text="📷 Seleccionar imagen"
                                        Style="{StaticResource SecondaryButton}"
                                        HeightRequest="40"
                                        Command="{Binding SeleccionarImagenCommand}"
                                        IsEnabled="{Binding IsSubiendoImagen, Converter={StaticResource InvertBoolConverter}}"
                                        IsVisible="{Binding IsSubiendoImagen, Converter={StaticResource InvertBoolConverter}}"/>
                                <ActivityIndicator IsRunning="{Binding IsSubiendoImagen}"
                                                   IsVisible="{Binding IsSubiendoImagen}"
                                                   Color="{StaticResource AccentColor}"
                                                   HeightRequest="40"/>
                            </Grid>
                            <Label Text="JPG, PNG o WebP · máx. 5 MB"
                                   FontFamily="DMSans" FontSize="11"
                                   TextColor="{StaticResource MutedColor}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- Categoria -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Categoria"
                           FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource MutedColor}"/>
                    <Border BackgroundColor="{StaticResource Surface2Color}"
                            StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <Picker ItemsSource="{Binding Categorias}"
                                SelectedItem="{Binding CategoriaSeleccionada}"
                                ItemDisplayBinding="{Binding Nombre, x:DataType=dto:CategoriaDto}"
                                TextColor="{StaticResource TextColor}"
                                TitleColor="{StaticResource MutedColor}"
                                Title="Seleccionar categoria"
                                BackgroundColor="Transparent"
                                Margin="8,4"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Desayuno gratuito -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Desayuno gratuito 🍊"
                           FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource MutedColor}"/>
                    <Grid ColumnDefinitions="*,8,*,8,*" RowDefinitions="Auto">

                        <!-- Ninguno -->
                        <Border Grid.Column="0"
                                Padding="0,10"
                                StrokeThickness="2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Ninguno">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource AccentColor}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Zumo">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Bocata">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="❌" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="Ninguno" FontFamily="SyneBold" FontSize="11"
                                       TextColor="{StaticResource TextColor}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetComponenteDesayunoCommand}"
                                                      CommandParameter="0"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Zumo -->
                        <Border Grid.Column="2"
                                Padding="0,10"
                                StrokeThickness="2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Zumo">
                                    <Setter Property="BackgroundColor" Value="#1a4fa3e8"/>
                                    <Setter Property="Stroke" Value="#4fa3e8"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Ninguno">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Bocata">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="🥤" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="Zumo" FontFamily="SyneBold" FontSize="11"
                                       TextColor="{StaticResource TextColor}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetComponenteDesayunoCommand}"
                                                      CommandParameter="1"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Bocata -->
                        <Border Grid.Column="4"
                                Padding="0,10"
                                StrokeThickness="2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Bocata">
                                    <Setter Property="BackgroundColor" Value="#1a4caf82"/>
                                    <Setter Property="Stroke" Value="#4caf82"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Ninguno">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding ComponenteDesayuno}"
                                             Value="Zumo">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Surface2Color}"/>
                                    <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="🥪" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="Bocata" FontFamily="SyneBold" FontSize="11"
                                       TextColor="{StaticResource TextColor}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetComponenteDesayunoCommand}"
                                                      CommandParameter="2"/>
                            </Border.GestureRecognizers>
                        </Border>

                    </Grid>
                </VerticalStackLayout>

                <!-- Alérgenos -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Alérgenos"
                           FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource MutedColor}"/>
                    <CollectionView ItemsSource="{Binding Alergenos}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="4" HorizontalItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type vm:AlergenoSeleccionable}">
                                <HorizontalStackLayout Spacing="8" Padding="0,2">
                                    <CheckBox IsChecked="{Binding Seleccionado}" Color="{StaticResource AccentColor}"/>
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Alergeno.Emoji}" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="{Binding Alergeno.Nombre}" FontFamily="DMSans" FontSize="13"
                                               TextColor="{StaticResource TextColor}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Mensaje de error -->
                <Border BackgroundColor="#1ae05252"
                        StrokeThickness="1" Stroke="#40e05252"
                        Padding="14,10"
                        IsVisible="{Binding HasError}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Label Text="{Binding Error}"
                           FontFamily="DMSans" FontSize="13"
                           TextColor="#e05252"/>
                </Border>

                <!-- Boton guardar -->
                <Button Style="{StaticResource PrimaryButton}"
                        Text="{Binding IsSaving, Converter={StaticResource IsSavingToText}}"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InvertBoolConverter}}"
                        Margin="0,8,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
