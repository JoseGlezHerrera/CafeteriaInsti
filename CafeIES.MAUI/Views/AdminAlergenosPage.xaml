<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.AdminAlergenosPage"
             x:DataType="vm:AdminAlergenosViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="16,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="←"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" WidthRequest="44" Padding="0"
                    Command="{Binding VolverCommand}"/>
            <Label Grid.Column="1" Text="Alérgenos" FontFamily="SyneBold" FontSize="20"
                   TextColor="{DynamicResource TextColor}" VerticalOptions="Center" Margin="8,0,0,0"/>
            <Button Grid.Column="2"
                    Text="+ Nuevo"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="38" Padding="14,0"
                    Command="{Binding NuevoAlergenoCommand}"/>
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="{StaticResource AccentColor}">
            <CollectionView ItemsSource="{Binding Alergenos}" Margin="16,12">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="10" Margin="0,80">
                        <Label Text="⚠️" FontSize="44" HorizontalOptions="Center"/>
                        <Label Text="Sin alérgenos. Pulsa + Nuevo para crear uno."
                               Style="{StaticResource SubtitleLabel}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:AlergenoDto">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                                <!-- Emoji -->
                                <Label Grid.Column="0"
                                       Text="{Binding Emoji}"
                                       FontSize="32" VerticalOptions="Center"/>

                                <!-- Nombre -->
                                <Label Grid.Column="1"
                                       Text="{Binding Nombre}"
                                       FontFamily="SyneBold" FontSize="16"
                                       TextColor="{DynamicResource TextColor}"
                                       VerticalOptions="Center"/>

                                <!-- Eliminar -->
                                <Button Grid.Column="2"
                                        Text="🗑️"
                                        FontSize="16"
                                        BackgroundColor="#e05252"
                                        TextColor="White"
                                        CornerRadius="10" HeightRequest="38" WidthRequest="44" Padding="0"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnEliminarClicked"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
