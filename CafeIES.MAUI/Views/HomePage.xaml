<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             x:Class="CafeIES.MAUI.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <!-- ── Header fijo ─────────────────────────────────────────────────── -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="24,16" ColumnDefinitions="*,Auto">

            <VerticalStackLayout Grid.Column="0">
                <Label Text="¿Qué quieres hoy?" FontFamily="SyneBold"
                       FontSize="22" TextColor="{DynamicResource TextColor}"
                       SemanticProperties.HeadingLevel="Level1"/>
            </VerticalStackLayout>

            <!-- Botón carrito con badge -->
            <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44">
                <Border BackgroundColor="{DynamicResource Surface2Color}"
                        StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                        WidthRequest="44" HeightRequest="44"
                        SemanticProperties.Description="Abrir carrito">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding IrAlCarritoCommand}"/>
                    </Border.GestureRecognizers>
                    <Label Text="🛒" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <!-- Badge -->
                <Border BackgroundColor="{StaticResource AccentColor}"
                        WidthRequest="18" HeightRequest="18"
                        HorizontalOptions="End" VerticalOptions="Start"
                        IsVisible="{Binding ItemsEnCarrito, Converter={StaticResource IntToBoolConverter}}">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    <Label Text="{Binding CarritoBadge}" FontFamily="SyneBold" FontSize="9"
                           TextColor="#0f0e0c" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Contenido scrollable ────────────────────────────────────────── -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- Banner bloqueo horario -->
                <Border Margin="24,16,24,0" Padding="16,14"
                        BackgroundColor="#1fe8834a" StrokeThickness="1" Stroke="#40e8834a"
                        IsVisible="{Binding MostrarBannerBloqueo}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="⏳" FontSize="18" Margin="0,0,10,0" VerticalOptions="Start"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Pedidos no disponibles ahora"
                                   FontFamily="SyneBold" FontSize="13" TextColor="#e8834a"/>
                            <Label Text="{Binding ProximaFranja}"
                                   FontFamily="DMSans" FontSize="12" TextColor="#e8834a"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Buscador -->
                <Border Margin="24,16,24,0" Padding="14,12"
                        BackgroundColor="{DynamicResource Surface2Color}"
                        StrokeThickness="1" Stroke="{DynamicResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Label Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0"/>
                        <Entry Grid.Column="1" Placeholder="Buscar bocadillo, bebida..."
                               PlaceholderColor="{DynamicResource MutedColor}"
                               TextColor="{DynamicResource TextColor}"
                               BackgroundColor="Transparent"
                               Text="{Binding Busqueda}"
                               SemanticProperties.Description="Buscar productos"/>
                    </Grid>
                </Border>

                <!-- Categorías (scroll horizontal) -->
                <Label Text="Categorías" FontFamily="SyneBold" FontSize="16"
                       TextColor="{DynamicResource TextColor}" Margin="24,20,24,12"/>

                <CollectionView ItemsSource="{Binding Categorias}"
                                ItemsLayout="HorizontalList"
                                HeightRequest="44"
                                Margin="24,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CategoriaChipItem">
                            <Border Margin="0,0,10,0" Padding="14,10" StrokeThickness="1.5"
                                    Stroke="{Binding IsSelected, Converter={StaticResource BoolToAccentBorderConverter}}"
                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToAccentBgConverter}}">
                                <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=SeleccionarCategoriaCommand}"
                                                          CommandParameter="{Binding Nombre}"/>
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Emoji}" FontSize="13"/>
                                    <Label Text="{Binding Nombre}" FontFamily="SyneBold" FontSize="13"
                                           TextColor="{Binding IsSelected, Converter={StaticResource BoolToAccentTextConverter}}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Grid de productos -->
                <Label Text="Disponibles hoy" FontFamily="SyneBold" FontSize="16"
                       TextColor="{DynamicResource TextColor}" Margin="24,20,24,12"
                       SemanticProperties.HeadingLevel="Level2"/>

                <!-- Skeleton loading (visible mientras carga la primera vez) -->
                <Grid x:Name="SkeletonGrid" IsVisible="{Binding IsLoading}"
                      Margin="24,0,24,24" RowDefinitions="Auto,Auto" RowSpacing="12"
                      ColumnDefinitions="*,*" ColumnSpacing="12">
                    <!-- Fila 1 -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid RowDefinitions="110,Auto">
                            <BoxView Grid.Row="0" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="20,20,0,0"/>
                            <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="8">
                                <BoxView HeightRequest="14" WidthRequest="100" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="70"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="50"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid RowDefinitions="110,Auto">
                            <BoxView Grid.Row="0" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="20,20,0,0"/>
                            <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="8">
                                <BoxView HeightRequest="14" WidthRequest="80"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="60"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="50"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <!-- Fila 2 -->
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid RowDefinitions="110,Auto">
                            <BoxView Grid.Row="0" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="20,20,0,0"/>
                            <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="8">
                                <BoxView HeightRequest="14" WidthRequest="90"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="65"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="50"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                        <Grid RowDefinitions="110,Auto">
                            <BoxView Grid.Row="0" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="20,20,0,0"/>
                            <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="8">
                                <BoxView HeightRequest="14" WidthRequest="110" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="75"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                                <BoxView HeightRequest="11" WidthRequest="50"  HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4" Margin="0,4,0,0"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Productos en grid 2 columnas -->
                <CollectionView ItemsSource="{Binding ProductosFiltrados}"
                                IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}"
                                Margin="24,0,24,24">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                             Spacing="10" Margin="0,40">
                            <Label Text="🔍" FontSize="44" HorizontalOptions="Center"/>
                            <Label Text="Sin resultados" FontFamily="SyneBold" FontSize="16"
                                   TextColor="{DynamicResource TextColor}" HorizontalOptions="Center"/>
                            <Label Text="Prueba con otra búsqueda o categoría"
                                   Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:ProductoDto">
                            <Border Style="{StaticResource Card}" Padding="0"
                                    Opacity="{Binding Stock, Converter={StaticResource StockToOpacityConverter}}"
                                    InputTransparent="{Binding Stock, Converter={StaticResource StockAcabadoConverter}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=VerDetalleProductoCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="110,Auto">

                                    <!-- Imagen / Emoji -->
                                    <Grid Grid.Row="0" BackgroundColor="{DynamicResource Surface2Color}">
                                        <Label Text="{Binding CategoriaEmoji}" FontSize="44"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <!-- Stock badge: solo muestra "Agotado" cuando Stock == 0 -->
                                        <Border HorizontalOptions="End" VerticalOptions="Start"
                                                Margin="8" Padding="6,3"
                                                BackgroundColor="{DynamicResource CardColor}" StrokeThickness="1"
                                                Stroke="#e05252"
                                                IsVisible="{Binding Stock, Converter={StaticResource StockAcabadoConverter}}">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Label Text="Agotado" FontFamily="SyneBold" FontSize="10" TextColor="#e05252"/>
                                        </Border>
                                    </Grid>

                                    <!-- Info -->
                                    <VerticalStackLayout Grid.Row="1" Padding="12" Spacing="4">
                                        <Label Text="{Binding Nombre}" FontFamily="SyneBold"
                                               FontSize="14" TextColor="{DynamicResource TextColor}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Descripcion}" Style="{StaticResource CaptionLabel}"
                                               LineBreakMode="TailTruncation"/>
                                        <!-- Alérgenos con prefijo ⚠️ Contiene: -->
                                        <HorizontalStackLayout Spacing="4" IsVisible="{Binding Alergenos, Converter={StaticResource AlergenosVisibleConverter}}">
                                            <Label Text="⚠️" FontSize="11"/>
                                            <Label Text="{Binding Alergenos, Converter={StaticResource AlergenosToEmojiConverter}}"
                                                   FontFamily="DMSans" FontSize="11"
                                                   TextColor="#e8834a"
                                                   LineBreakMode="WordWrap"/>
                                        </HorizontalStackLayout>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                            <Label Grid.Column="0" FontFamily="SyneBold" FontSize="16"
                                                   TextColor="{StaticResource AccentColor}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Precio, StringFormat='{0:F2}'}"/>
                                                        <Span Text="€"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <!-- Botón + (deshabilitado si agotado) -->
                                            <Border Grid.Column="1" BackgroundColor="{StaticResource AccentColor}"
                                                    WidthRequest="30" HeightRequest="30"
                                                    Opacity="{Binding Stock, Converter={StaticResource StockToOpacityConverter}}"
                                                    SemanticProperties.Description="Añadir al carrito">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="9"/></Border.StrokeShape>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=AnadirAlCarritoCommand}"
                                                        CommandParameter="{Binding .}"/>
                                                </Border.GestureRecognizers>
                                                <Label Text="+" FontFamily="SyneBold" FontSize="20"
                                                       TextColor="#0f0e0c" HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       IsEnabled="{Binding Stock, Converter={StaticResource StockDisponibleConverter}}"/>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
