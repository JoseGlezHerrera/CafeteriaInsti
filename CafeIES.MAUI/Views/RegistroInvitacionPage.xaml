<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CafeIES.MAUI.Views.RegistroInvitacionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
    x:DataType="vm:RegistroInvitacionViewModel"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F0E0C" Offset="0"/>
            <GradientStop Color="#0F1A10" Offset="1"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,40" Spacing="0">

            <!-- Back + title -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,28">
                <Button Grid.Column="0"
                        Text="←"
                        Command="{Binding VolverCommand}"
                        Style="{StaticResource BtnOutline}"
                        WidthRequest="44" HeightRequest="44"
                        Padding="0"/>
                <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0">
                    <Label Text="Crear cuenta" Style="{StaticResource H2}"/>
                    <Label Text="Solo necesitas nombre y contraseña"
                           Style="{StaticResource Caption}"/>
                </VerticalStackLayout>
            </Grid>

            <!-- Introducir código manualmente (cuando no viene por query param) -->
            <VerticalStackLayout IsVisible="{Binding TokenVerificado, Converter={StaticResource InvertBoolConverter}}"
                                 Margin="0,0,0,20" Spacing="10">
                <Label Text="CÓDIGO DE INVITACIÓN" FontFamily="SyneBold" FontSize="11"
                       TextColor="{StaticResource MutedColor}" CharacterSpacing="1.5"/>
                <Border StrokeThickness="1.5" Stroke="{StaticResource BorderColor}"
                        BackgroundColor="{StaticResource Surface2Color}" Padding="4,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                    <Entry Style="{StaticResource InputEntry}"
                           Placeholder="Pega aquí tu código"
                           Text="{Binding CodigoManual}"/>
                </Border>
                <Button Text="Verificar código →"
                        Command="{Binding VerificarCodigoCommand}"
                        HeightRequest="52" CornerRadius="16"
                        FontFamily="SyneBold" FontSize="15"
                        TextColor="#0F0E0C"
                        BackgroundColor="{StaticResource AccentColor}"/>
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   Color="{StaticResource AccentColor}" HorizontalOptions="Center"/>
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource RedColor}"
                       FontSize="13" IsVisible="{Binding HayError}"/>
            </VerticalStackLayout>

            <!-- Formulario de registro (visible solo tras verificar) -->
            <VerticalStackLayout IsVisible="{Binding TokenVerificado}" Spacing="0">

            <!-- Invite badge -->
            <Border Padding="14,12" Margin="0,0,0,24"
                    BackgroundColor="#0D2B18"
                    StrokeThickness="1">
                <Border.Stroke>
                    <SolidColorBrush Color="#1E5E30"/>
                </Border.Stroke>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="🔗" FontSize="20" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0">
                        <Label Text="Invitación válida"
                               FontFamily="SyneBold" FontSize="13"
                               TextColor="{StaticResource GreenColor}"/>
                        <Label FontSize="11" TextColor="{StaticResource MutedColor}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Rol asignado: "/>
                                    <Span Text="{Binding RolTexto}"
                                          FontFamily="SyneBold"
                                          TextColor="{StaticResource TextColor}"/>
                                    <Span Text=" · Sin restricción horaria"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Nombre -->
            <Label Text="NOMBRE COMPLETO" Style="{StaticResource Caption}"
                   FontFamily="SyneBold" FontSize="11" CharacterSpacing="1.5"
                   Margin="0,0,0,8"/>
            <Border Style="{StaticResource InputBox}" Margin="0,0,0,16">
                <Entry Style="{StaticResource InputStyle}"
                       Placeholder="Nombre y apellidos"
                       Text="{Binding Nombre}"/>
            </Border>

            <!-- Email -->
            <Label Text="CORREO DEL CENTRO" Style="{StaticResource Caption}"
                   FontFamily="SyneBold" FontSize="11" CharacterSpacing="1.5"
                   Margin="0,0,0,8"/>
            <Border Style="{StaticResource InputBox}" Margin="0,0,0,16">
                <Entry Style="{StaticResource InputStyle}"
                       Placeholder="usuario@ies.edu"
                       Keyboard="Email"
                       Text="{Binding Email}"/>
            </Border>

            <!-- Contraseña -->
            <Label Text="CONTRASEÑA" Style="{StaticResource Caption}"
                   FontFamily="SyneBold" FontSize="11" CharacterSpacing="1.5"
                   Margin="0,0,0,8"/>
            <Border Style="{StaticResource InputBox}" Margin="0,0,0,16">
                <Entry Style="{StaticResource InputStyle}"
                       Placeholder="Mínimo 8 caracteres"
                       IsPassword="True"
                       Text="{Binding Password}"/>
            </Border>

            <!-- Confirmar contraseña -->
            <Label Text="CONFIRMAR CONTRASEÑA" Style="{StaticResource Caption}"
                   FontFamily="SyneBold" FontSize="11" CharacterSpacing="1.5"
                   Margin="0,0,0,8"/>
            <Border Style="{StaticResource InputBox}" Margin="0,0,0,8">
                <Entry Style="{StaticResource InputStyle}"
                       Placeholder="Repite la contraseña"
                       IsPassword="True"
                       Text="{Binding ConfirmarPassword}"/>
            </Border>

            <!-- Instituto -->
            <Label Text="INSTITUTO" Style="{StaticResource Caption}"
                   FontFamily="SyneBold" FontSize="11" CharacterSpacing="1.5"
                   Margin="0,8,0,8"/>
            <Border Style="{StaticResource InputBox}" Margin="0,0,0,8">
                <Picker ItemsSource="{Binding Institutos}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding InstitutoSeleccionado}"
                        Title="Selecciona tu instituto"
                        TextColor="{StaticResource TextColor}"
                        TitleColor="{StaticResource MutedColor}"
                        FontFamily="DMSans" FontSize="15"
                        HorizontalOptions="FillAndExpand"/>
            </Border>

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="{StaticResource RedColor}"
                   FontSize="13"
                   IsVisible="{Binding HayError}"
                   Margin="0,4,0,0"/>

            <!-- Botón -->
            <Button Text="Activar cuenta →"
                    Command="{Binding ActivarCommand}"
                    Margin="0,28,0,0"
                    HeightRequest="54"
                    CornerRadius="16"
                    FontFamily="SyneBold"
                    FontSize="15"
                    TextColor="#0F0E0C"
                    BackgroundColor="{StaticResource GreenColor}"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource GreenColor}"
                               HorizontalOptions="Center"
                               Margin="0,12,0,0"/>

            <Label Text="Cuenta activa de inmediato · Sin validación manual"
                   Style="{StaticResource Caption}"
                   HorizontalOptions="Center"
                   Margin="0,16,0,0"/>

            </VerticalStackLayout><!-- fin VerticalStackLayout TokenVerificado -->

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
