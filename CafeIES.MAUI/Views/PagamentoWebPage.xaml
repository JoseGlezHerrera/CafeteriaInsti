<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CafeIES.MAUI.Views.PagamentoWebPage"
             BackgroundColor="{StaticResource BgColor}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceColor}"
              Padding="16,14,20,14" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Text="←"
                    FontFamily="SyneBold" FontSize="20"
                    TextColor="{StaticResource AccentColor}"
                    BackgroundColor="Transparent"
                    WidthRequest="44" HeightRequest="44"
                    Clicked="OnVolverClicked"/>
            <Label Grid.Column="1" Text="Pago seguro"
                   FontFamily="SyneBold" FontSize="20"
                   TextColor="{StaticResource TextColor}"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- WebView -->
        <WebView Grid.Row="1" x:Name="FormWebView"
                 Navigating="OnNavigating"
                 Navigated="OnNavigated"/>

        <!-- Loading overlay (visible hasta que carga el formulario) -->
        <Grid Grid.Row="1" x:Name="LoadingOverlay"
              BackgroundColor="{StaticResource BgColor}">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                <ActivityIndicator IsRunning="True" Color="{StaticResource AccentColor}"
                                   WidthRequest="40" HeightRequest="40"/>
                <Label x:Name="LoadingLabel" Text="Cargando formulario de pago…"
                       FontFamily="DMSans" FontSize="14"
                       TextColor="{StaticResource MutedColor}"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
