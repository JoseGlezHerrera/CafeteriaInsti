<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             x:Class="CafeIES.MAUI.Views.PedidosPage"
             x:DataType="vm:PedidosViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Resources>
        <!--  Tarjeta de pedido — instanciada manualmente en RebuildList() para evitar
              el bug de BindableLayout que acumula suscripciones a CollectionChanged
              al navegar entre tabs en MAUI Shell, causando duplicación visual.  -->
        <DataTemplate x:Key="PedidoCardTemplate" x:DataType="dto:PedidoDto">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

                    <!-- Fila 1: Número + estado -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" FontFamily="SyneBold" FontSize="16"
                               TextColor="{StaticResource AccentColor}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="#"/>
                                    <Span Text="{Binding NumeroPedido, StringFormat='{0:D3}'}"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Border Grid.Column="1" Padding="10,4"
                                BackgroundColor="{Binding Estado, Converter={StaticResource EstadoPedidoBgConverter}}"
                                StrokeThickness="1"
                                Stroke="{Binding Estado, Converter={StaticResource EstadoPedidoBorderConverter}}">
                            <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                            <Label Text="{Binding Estado, Converter={StaticResource EstadoPedidoLabelConverter}}"
                                   FontFamily="SyneBold" FontSize="11"
                                   TextColor="{Binding Estado, Converter={StaticResource EstadoPedidoTextConverter}}"/>
                        </Border>
                    </Grid>

                    <!-- Fila 2: Items del pedido -->
                    <Label Grid.Row="1" Style="{StaticResource SubtitleLabel}" FontSize="13"
                           Text="{Binding Lineas, Converter={StaticResource LineasResumenConverter}}"
                           LineBreakMode="TailTruncation"/>

                    <!-- Fila 3: Fecha + total -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding FechaCreacion, Converter={StaticResource UtcToLocalDateTimeConverter}, ConverterParameter='dd/MM/yyyy HH:mm'}"
                               Style="{StaticResource CaptionLabel}"/>
                        <Label Grid.Column="1" FontFamily="SyneBold" FontSize="15"
                               TextColor="{DynamicResource TextColor}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Total, StringFormat='{0:F2}'}"/>
                                    <Span Text="€"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}" Padding="24,16">
            <Label Text="Mis pedidos" FontFamily="SyneBold" FontSize="22"
                   TextColor="{DynamicResource TextColor}"/>
        </Grid>

        <!-- Filtro por fecha -->
        <ScrollView Grid.Row="1" Orientation="Horizontal"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Padding="16,10,16,14" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Hoy"  Command="{Binding SetFiltroFechaCommand}" CommandParameter="Hoy"
                        Style="{Binding FiltroHoyActivo,  Converter={StaticResource BoolToChipStyleConverter}}"/>
                <Button Text="Todo" Command="{Binding SetFiltroFechaCommand}" CommandParameter="Todo"
                        Style="{Binding FiltroTodoActivo, Converter={StaticResource BoolToChipStyleConverter}}"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Skeleton — visible mientras carga -->
        <VerticalStackLayout x:Name="SkeletonPedidos" Grid.Row="2"
                              BackgroundColor="{DynamicResource BgColor}"
                              IsVisible="{Binding CargarCommand.IsRunning}"
                              Margin="24,16" Spacing="12">
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <BoxView Grid.Column="0" HeightRequest="16" WidthRequest="60" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="6"/>
                        <BoxView Grid.Column="1" HeightRequest="22" WidthRequest="80" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="11"/>
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="13" WidthRequest="200" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <BoxView Grid.Column="0" HeightRequest="11" WidthRequest="130" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                        <BoxView Grid.Column="1" HeightRequest="15" WidthRequest="55" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <BoxView Grid.Column="0" HeightRequest="16" WidthRequest="60" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="6"/>
                        <BoxView Grid.Column="1" HeightRequest="22" WidthRequest="80" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="11"/>
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="13" WidthRequest="180" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <BoxView Grid.Column="0" HeightRequest="11" WidthRequest="130" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                        <BoxView Grid.Column="1" HeightRequest="15" WidthRequest="55" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <BoxView Grid.Column="0" HeightRequest="16" WidthRequest="60" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="6"/>
                        <BoxView Grid.Column="1" HeightRequest="22" WidthRequest="70" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="11"/>
                    </Grid>
                    <BoxView Grid.Row="1" HeightRequest="13" WidthRequest="220" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                        <BoxView Grid.Column="0" HeightRequest="11" WidthRequest="130" HorizontalOptions="Start" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                        <BoxView Grid.Column="1" HeightRequest="15" WidthRequest="55" BackgroundColor="{DynamicResource Surface2Color}" CornerRadius="4"/>
                    </Grid>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2" Command="{Binding CargarCommand}"
                     IsRefreshing="{Binding CargarCommand.IsRunning}"
                     RefreshColor="{StaticResource AccentColor}">
            <ScrollView>
                <VerticalStackLayout Margin="24,16" Spacing="0">

                    <!-- Estado vacío -->
                    <VerticalStackLayout IsVisible="{Binding SinPedidos}"
                                         VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="12" Margin="0,80">
                        <Label Text="📋" FontSize="60" HorizontalOptions="Center"/>
                        <Label Text="Sin pedidos aún" FontFamily="SyneBold" FontSize="18"
                               TextColor="{DynamicResource TextColor}" HorizontalOptions="Center"/>
                        <Label Text="Tus pedidos aparecerán aquí" Style="{StaticResource SubtitleLabel}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- Ítems — construidos en RebuildList() desde code-behind -->
                    <VerticalStackLayout x:Name="PedidosList" Spacing="0"/>

                    <!-- Cargar más -->
                    <VerticalStackLayout Padding="0,4,0,20">
                        <Button Text="Cargar más"
                                Command="{Binding CargarMasCommand}"
                                IsVisible="{Binding HayMas}"
                                IsEnabled="{Binding IsCargandoMas, Converter={StaticResource InvertBoolConverter}}"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalOptions="Center" Margin="0,8"/>
                        <ActivityIndicator IsRunning="{Binding IsCargandoMas}"
                                           IsVisible="{Binding IsCargandoMas}"
                                           Color="{StaticResource AccentColor}"
                                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
