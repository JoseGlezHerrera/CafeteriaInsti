<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.AdminIngredientesPage"
             x:DataType="vm:AdminIngredientesViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="16,14" ColumnDefinitions="Auto,*,Auto,6,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="←"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" WidthRequest="44" Padding="0"
                    Command="{Binding VolverCommand}"/>
            <Label Grid.Column="1" Text="Ingredientes" FontFamily="SyneBold" FontSize="20"
                   TextColor="{DynamicResource TextColor}" VerticalOptions="Center" Margin="8,0,0,0"/>
            <Button Grid.Column="2"
                    Text="Alérgenos"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" FontSize="12" Padding="10,0"
                    Clicked="OnIrAlergenosClicked"/>
            <Button Grid.Column="4"
                    Text="+ Nuevo"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="38" Padding="14,0"
                    Command="{Binding NuevoIngredienteCommand}"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="{StaticResource AccentColor}">
            <CollectionView ItemsSource="{Binding Ingredientes}" Margin="16,12">

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="10" Margin="0,80">
                        <Label Text="🥬" FontSize="44" HorizontalOptions="Center"/>
                        <Label Text="Sin ingredientes. Pulsa + Nuevo para crear uno."
                               Style="{StaticResource SubtitleLabel}"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:IngredienteDto">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Emoji -->
                                <Label Grid.Column="0"
                                       Text="{Binding Emoji}"
                                       FontSize="28" VerticalOptions="Center"/>

                                <!-- Info -->
                                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}"
                                           FontFamily="SyneBold" FontSize="15"
                                           TextColor="{DynamicResource TextColor}"/>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label FontFamily="DMSans" FontSize="12"
                                               TextColor="{DynamicResource MutedColor}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Stock: "/>
                                                    <Span Text="{Binding Stock, StringFormat='{0} uds'}"
                                                          FontFamily="SyneBold"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label FontFamily="DMSans" FontSize="12"
                                               TextColor="{StaticResource AccentColor}"
                                               IsVisible="{Binding PrecioExtra, Converter={StaticResource DecimalPositivoConverter}}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="+"/>
                                                    <Span Text="{Binding PrecioExtra, StringFormat='{0:F2}'}"/>
                                                    <Span Text="€"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Botones -->
                                <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Button Text="Editar"
                                            FontFamily="SyneBold" FontSize="11"
                                            BackgroundColor="{DynamicResource Surface2Color}"
                                            TextColor="{DynamicResource TextColor}"
                                            CornerRadius="10" HeightRequest="34" Padding="14,0"
                                            WidthRequest="78"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEditarClicked"/>
                                    <Button Text="{Binding Activo, Converter={StaticResource ActivoTextoConverter}}"
                                            FontFamily="SyneBold" FontSize="11"
                                            BackgroundColor="{Binding Activo, Converter={StaticResource ActivoBgConverter}}"
                                            TextColor="{Binding Activo, Converter={StaticResource ActivoTextColorConverter}}"
                                            CornerRadius="10" HeightRequest="34" Padding="14,0"
                                            WidthRequest="78"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnToggleActivoClicked"/>
                                    <Button Text="🗑️"
                                            FontFamily="SyneBold" FontSize="14"
                                            BackgroundColor="#e05252"
                                            TextColor="White"
                                            CornerRadius="10" HeightRequest="34" Padding="0"
                                            WidthRequest="78"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEliminarClicked"/>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
