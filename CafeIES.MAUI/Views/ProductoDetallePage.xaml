<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.ProductoDetallePage"
             x:DataType="vm:ProductoDetalleViewModel"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceColor}"
              Padding="16,14" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Text="Volver"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" Padding="12,0"
                    Command="{Binding VolverCommand}"/>
            <Label Grid.Column="1"
                   Text="Detalle del producto"
                   FontFamily="SyneBold" FontSize="18"
                   TextColor="{StaticResource TextColor}"
                   Margin="12,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource AccentColor}"
                           Margin="0,40"/>

        <!-- Contenido -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Padding="24,20" Spacing="20"
                                 IsVisible="{Binding TieneProducto}">

                <!-- Emoji / Imagen grande -->
                <Border BackgroundColor="{StaticResource Surface2Color}"
                        WidthRequest="160" HeightRequest="160"
                        HorizontalOptions="Center"
                        StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28"/></Border.StrokeShape>
                    <Label Text="{Binding Producto.CategoriaEmoji}"
                           FontSize="72"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Nombre -->
                <Label Text="{Binding Producto.Nombre}"
                       FontFamily="SyneBold" FontSize="26"
                       TextColor="{StaticResource TextColor}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Precio -->
                <Label FontFamily="SyneBold" FontSize="32"
                       TextColor="{StaticResource AccentColor}"
                       HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding Producto.Precio, StringFormat='{0:F2}'}"/>
                            <Span Text="€"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Descripcion -->
                <Label Text="{Binding Producto.Descripcion}"
                       FontFamily="DMSans" FontSize="15"
                       TextColor="{StaticResource TextColor}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding TieneDescripcion}"/>

                <!-- Separador -->
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" Margin="0,4"/>

                <!-- Sección de alérgenos -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding Producto.Alergenos, Converter={StaticResource AlergenosVisibleConverter}}">
                    <Label Text="Contiene alérgenos"
                           FontFamily="SyneBold" FontSize="14"
                           TextColor="{StaticResource MutedColor}"/>
                    <CollectionView ItemsSource="{Binding Producto.Alergenos}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:AlergenoDto">
                                <HorizontalStackLayout Spacing="10">
                                    <Border BackgroundColor="{StaticResource Surface2Color}"
                                            Padding="10,6"
                                            StrokeThickness="1" Stroke="{StaticResource BorderColor}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Emoji}" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="{Binding Nombre}"
                                                   FontFamily="DMSans" FontSize="13"
                                                   TextColor="{StaticResource TextColor}"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón añadir al carrito -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource SurfaceColor}"
                StrokeThickness="1" Stroke="{StaticResource BorderColor}"
                Padding="24,16"
                IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0"/></Border.StrokeShape>
            <Button Text="Añadir al carrito"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AnadirAlCarritoCommand}"
                    IsEnabled="{Binding PuedeAnadir}"/>
        </Border>

    </Grid>
</ContentPage>
