<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:conv="clr-namespace:CafeIES.MAUI.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.ProductoDetallePage"
             x:DataType="vm:ProductoDetalleViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid x:Name="PageContent" RowDefinitions="Auto,*,Auto" Opacity="0" TranslationY="18">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="16,14" ColumnDefinitions="Auto,*">
            <Button Grid.Column="0"
                    Text="Volver"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" Padding="12,0"
                    Command="{Binding VolverCommand}"/>
            <Label Grid.Column="1"
                   Text="Detalle del producto"
                   FontFamily="SyneBold" FontSize="18"
                   TextColor="{DynamicResource TextColor}"
                   Margin="12,0,0,0" VerticalOptions="Center"/>
        </Grid>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource AccentColor}"
                           Margin="0,40"/>

        <!-- Contenido -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
            <VerticalStackLayout Padding="24,20" Spacing="20"
                                 IsVisible="{Binding TieneProducto}">

                <!-- Imagen / Emoji del producto -->
                <Border BackgroundColor="{DynamicResource Surface2Color}"
                        WidthRequest="160" HeightRequest="160"
                        HorizontalOptions="Center"
                        StrokeThickness="1" Stroke="{DynamicResource BorderColor}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28"/></Border.StrokeShape>
                    <Grid>
                        <Image Source="{Binding ImagenUrlCompleta}"
                               Aspect="AspectFill"
                               IsVisible="{Binding TieneImagen}"/>
                        <Label Text="{Binding Producto.CategoriaEmoji}"
                               FontSize="72"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               IsVisible="{Binding TieneImagen, Converter={StaticResource InvertBoolConverter}}"/>
                    </Grid>
                </Border>

                <!-- Nombre -->
                <Label Text="{Binding Producto.Nombre}"
                       FontFamily="SyneBold" FontSize="26"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>

                <!-- Precio (se actualiza con las personalizaciones) -->
                <Label FontFamily="SyneBold" FontSize="32"
                       TextColor="{StaticResource AccentColor}"
                       HorizontalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding PrecioConPersonalizacion, StringFormat='{0:F2}'}"/>
                            <Span Text="€"/>
                        </FormattedString>
                    </Label.FormattedText>
                </Label>

                <!-- Descripcion -->
                <Label Text="{Binding Producto.Descripcion}"
                       FontFamily="DMSans" FontSize="15"
                       TextColor="{DynamicResource TextColor}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       IsVisible="{Binding TieneDescripcion}"/>

                <!-- Separador -->
                <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}" Margin="0,4"/>

                <!-- Ingredientes personalizables -->
                <VerticalStackLayout Spacing="10"
                                     IsVisible="{Binding TieneIngredientes}">
                    <Label Text="Personalizar ingredientes"
                           FontFamily="SyneBold" FontSize="14"
                           TextColor="{DynamicResource MutedColor}"/>
                    <CollectionView ItemsSource="{Binding IngredientesSeleccion}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="4"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:IngredienteSeleccionVm">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="10" Padding="0,4">
                                    <Label Grid.Column="0"
                                           Text="{Binding Config.Emoji}" FontSize="20"
                                           VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                        <Label Text="{Binding Config.Nombre}"
                                               FontFamily="DMSans" FontSize="14"
                                               TextColor="{DynamicResource TextColor}"/>
                                        <Label Text="{Binding EtiquetaPrecio}"
                                               FontSize="11"
                                               TextColor="{StaticResource AccentColor}"
                                               IsVisible="{Binding EtiquetaPrecio,
                                                   Converter={StaticResource StringNotNullOrEmptyConverter}}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="base" FontSize="10"
                                           TextColor="{DynamicResource MutedColor}"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding Config.EsBase}"/>
                                    <!-- Switch (ingredientes base o extras binarios) -->
                                    <Switch Grid.Column="3"
                                            IsToggled="{Binding Seleccionado}"
                                            IsEnabled="{Binding PuedeModificar}"
                                            OnColor="{StaticResource AccentColor}"
                                            VerticalOptions="Center"
                                            IsVisible="{Binding UsaStepper,
                                                Converter={StaticResource InvertBoolConverter}}"/>
                                    <!-- Stepper (extras con CantidadMaxima > 1) -->
                                    <Border Grid.Column="3"
                                            BackgroundColor="{DynamicResource Surface2Color}"
                                            StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                                            Padding="8,4" VerticalOptions="Center"
                                            IsVisible="{Binding UsaStepper}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="−" FontFamily="SyneBold" FontSize="18"
                                                   TextColor="{StaticResource AccentColor}" VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding DecrementarCantidadCommand}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label Grid.Column="1" Text="{Binding Cantidad}"
                                                   FontFamily="SyneBold" FontSize="14"
                                                   TextColor="{DynamicResource TextColor}"
                                                   VerticalOptions="Center"
                                                   MinimumWidthRequest="18" HorizontalOptions="Center"/>
                                            <Label Grid.Column="2" Text="+" FontFamily="SyneBold" FontSize="18"
                                                   TextColor="{StaticResource AccentColor}" VerticalOptions="Center">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding IncrementarCantidadCommand}"/>
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}" Margin="0,4"/>
                </VerticalStackLayout>

                <!-- Sección de alérgenos -->
                <VerticalStackLayout Spacing="12"
                                     IsVisible="{Binding Producto.Alergenos, Converter={StaticResource AlergenosVisibleConverter}}">
                    <Label Text="Contiene alérgenos"
                           FontFamily="SyneBold" FontSize="14"
                           TextColor="{DynamicResource MutedColor}"/>
                    <CollectionView ItemsSource="{Binding Producto.Alergenos}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:AlergenoDto">
                                <HorizontalStackLayout Spacing="10">
                                    <Border BackgroundColor="{DynamicResource Surface2Color}"
                                            Padding="10,6"
                                            StrokeThickness="1" Stroke="{DynamicResource BorderColor}">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Emoji}" FontSize="16" VerticalOptions="Center"/>
                                            <Label Text="{Binding Nombre}"
                                                   FontFamily="DMSans" FontSize="13"
                                                   TextColor="{DynamicResource TextColor}"
                                                   VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </Border>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Botón añadir al carrito -->
        <Border Grid.Row="2"
                BackgroundColor="{DynamicResource SurfaceColor}"
                StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                Padding="24,16"
                IsVisible="{Binding IsLoading, Converter={StaticResource InvertBoolConverter}}">
            <Border.StrokeShape><RoundRectangle CornerRadius="0"/></Border.StrokeShape>
            <Button Text="{Binding TextoBotonCarrito}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AnadirAlCarritoCommand}"
                    IsEnabled="{Binding PuedeAnadir}"/>
        </Border>

    </Grid>
</ContentPage>
