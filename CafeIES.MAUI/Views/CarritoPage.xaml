<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             x:Class="CafeIES.MAUI.Views.CarritoPage"
             x:DataType="vm:CarritoViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}" Padding="24,14,24,16">
            <VerticalStackLayout Spacing="2">
                <Label Text="Mi carrito" FontFamily="SyneBold"
                       FontSize="22" TextColor="{DynamicResource TextColor}"/>
                <Label Text="{Binding TotalItems, StringFormat='{0} art&#237;culos'}"
                       Style="{StaticResource CaptionLabel}"
                       IsVisible="{Binding CarritoVacio, Converter={StaticResource InvertBoolConverter}}"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Carrito vacío -->
        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" HorizontalOptions="Center"
                             IsVisible="{Binding CarritoVacio}" Spacing="12">
            <Label Text="🛒" FontSize="60" HorizontalOptions="Center"/>
            <Label Text="Tu carrito está vacío" FontFamily="SyneBold" FontSize="18"
                   TextColor="{DynamicResource TextColor}" HorizontalOptions="Center"/>
            <Label Text="Añade algo desde la carta" Style="{StaticResource SubtitleLabel}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>

        <!-- Todo el contenido scrollable cuando hay items -->
        <ScrollView Grid.Row="1"
                    IsVisible="{Binding CarritoVacio, Converter={StaticResource InvertBoolConverter}}"
                    InputTransparent="{Binding IsLoading}">
            <VerticalStackLayout Spacing="0">

                <!-- Lista de items
                     x:Name permite el workaround de null+reassign en OnAppearing
                     para evitar el bug de duplicación visual de BindableLayout en MAUI -->
                <VerticalStackLayout x:Name="ItemsList"
                                     BindableLayout.ItemsSource="{Binding Items}"
                                     Margin="0,12,0,8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemCarrito">
                            <SwipeView Margin="16,0,16,10">
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItemView
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=EliminarItemCommand}"
                                            CommandParameter="{Binding .}">
                                            <Border BackgroundColor="{StaticResource RedColor}"
                                                    WidthRequest="80" HeightRequest="68" Padding="0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                                <Label Text="🗑️" FontSize="24"
                                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </SwipeItemView>
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                            <Border Grid.Column="0" BackgroundColor="{DynamicResource Surface2Color}"
                                                    WidthRequest="52" HeightRequest="52">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                                <Grid>
                                                    <Image Source="{Binding ImagenUrl}" Aspect="AspectFill"
                                                           IsVisible="{Binding TieneImagen}"/>
                                                    <Label Text="🍽" FontSize="26"
                                                           HorizontalOptions="Center" VerticalOptions="Center"
                                                           IsVisible="{Binding TieneImagen, Converter={StaticResource InvertBoolConverter}}"/>
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                                <Label Text="{Binding Nombre}" FontFamily="SyneBold"
                                                       FontSize="14" TextColor="{DynamicResource TextColor}"/>
                                                <Label FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource MutedColor}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding PrecioUnitario, StringFormat='{0:F2}'}"/>
                                                            <Span Text="€ c/u"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding IngredientesDescripcion}"
                                                       FontFamily="DMSans" FontSize="11"
                                                       FontAttributes="Italic"
                                                       TextColor="{StaticResource AccentColor}"
                                                       LineBreakMode="WordWrap"
                                                       IsVisible="{Binding TieneIngredientes}"/>
                                                <Label Text="✏️ Editar ingredientes"
                                                       FontFamily="DMSans" FontSize="11"
                                                       TextColor="{StaticResource AccentColor}"
                                                       IsVisible="{Binding TieneConfiguracionIngredientes}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=EditarIngredientesCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </VerticalStackLayout>
                                            <!-- Stepper: botones circulares 44×44 para toque cómodo en móvil -->
                                            <Grid Grid.Column="2"
                                                  ColumnDefinitions="44,40,44" ColumnSpacing="0"
                                                  VerticalOptions="Center">
                                                <!-- Botón − -->
                                                <Border Grid.Column="0"
                                                        WidthRequest="44" HeightRequest="44"
                                                        BackgroundColor="{DynamicResource Surface2Color}"
                                                        StrokeThickness="1.5"
                                                        Stroke="{DynamicResource BorderColor}">
                                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                    <Label Text="−" FontFamily="SyneBold" FontSize="22"
                                                           TextColor="{StaticResource AccentColor}"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Margin="0,0,0,1"/>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=DecrementarCantidadCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>
                                                <!-- Cantidad -->
                                                <Label Grid.Column="1"
                                                       Text="{Binding Cantidad}"
                                                       FontFamily="SyneBold" FontSize="17"
                                                       TextColor="{DynamicResource TextColor}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                                <!-- Botón + -->
                                                <Border Grid.Column="2"
                                                        WidthRequest="44" HeightRequest="44"
                                                        BackgroundColor="{StaticResource AccentColor}"
                                                        StrokeThickness="0">
                                                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                                                    <Label Text="+" FontFamily="SyneBold" FontSize="22"
                                                           TextColor="White"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Margin="0,0,0,1"/>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CarritoViewModel}}, Path=IncrementarCantidadCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                        <!-- Nota por producto -->
                                        <Border StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                                                BackgroundColor="{DynamicResource Surface2Color}" Padding="10,2">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                            <Entry Placeholder="Nota (ej: sin queso, extra picante…)"
                                                   PlaceholderColor="{DynamicResource MutedColor}"
                                                   TextColor="{DynamicResource TextColor}"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding Notas}"
                                                   FontSize="12" MaxLength="200"/>
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Banner desayuno gratuito -->
                <Border IsVisible="{Binding TieneDesayunoGratuito}"
                        BackgroundColor="#1a4caf82" StrokeThickness="1" Stroke="#4caf82"
                        Padding="16,12" Margin="16,0,16,8">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="🍊" FontSize="26" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding MensajeDesayuno}"
                               FontFamily="DMSans" FontSize="13"
                               TextColor="{StaticResource GreenColor}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Resumen + Pago -->
                <VerticalStackLayout BackgroundColor="{DynamicResource SurfaceColor}"
                                     Padding="24,16,24,28" Spacing="0">

                    <Label Text="Resumen del pedido" FontFamily="SyneBold" FontSize="12"
                           TextColor="{DynamicResource MutedColor}" Margin="0,0,0,10"/>

                    <!-- Resumen totales -->
                    <Border BackgroundColor="{DynamicResource Surface2Color}"
                            StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                            Padding="18,16" Margin="0,0,0,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding TotalItems, StringFormat='{0} artículo(s)'}"
                                   Style="{StaticResource CaptionLabel}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Subtotal" Style="{StaticResource SubtitleLabel}"/>
                                <Label Grid.Column="1" FontFamily="DMSans" FontSize="14"
                                       TextColor="{DynamicResource TextColor}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Total, StringFormat='{0:F2}'}"/>
                                            <Span Text=" €"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                            <!-- Descuento desayuno gratuito (solo si hay beneficio) -->
                            <Grid ColumnDefinitions="*,Auto"
                                  IsVisible="{Binding HayDesayunoDisponible}">
                                <Label Grid.Column="0" Text="Desayuno gratuito 🍊"
                                       Style="{StaticResource SubtitleLabel}"
                                       TextColor="{StaticResource GreenColor}"/>
                                <Label Grid.Column="1" FontFamily="DMSans" FontSize="14"
                                       TextColor="{StaticResource GreenColor}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="-"/>
                                            <Span Text="{Binding Descuento, StringFormat='{0:F2}'}"/>
                                            <Span Text=" €"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="{DynamicResource BorderColor}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Total" FontFamily="SyneBold"
                                       FontSize="20" TextColor="{DynamicResource TextColor}"/>
                                <Label Grid.Column="1" FontFamily="SyneBold" FontSize="20"
                                       TextColor="{StaticResource AccentColor}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding TotalEfectivo, StringFormat='{0:F2}'}"/>
                                            <Span Text=" €"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Notas opcionales -->
                    <Border BackgroundColor="{DynamicResource Surface2Color}"
                            StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                            Padding="14,10" Margin="0,0,0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Notas para la cocina" FontFamily="SyneBold" FontSize="12"
                                   TextColor="{DynamicResource MutedColor}"/>
                            <Editor Placeholder="Sin lechuga, extra picante..."
                                    PlaceholderColor="{DynamicResource MutedColor}"
                                    TextColor="{DynamicResource TextColor}"
                                    BackgroundColor="Transparent"
                                    Text="{Binding Notas}"
                                    HeightRequest="50" AutoSize="TextChanges"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Indicador de carga del estado de desayuno -->
                    <ActivityIndicator IsRunning="{Binding IsLoadingDesayuno}"
                                       IsVisible="{Binding IsLoadingDesayuno}"
                                       Color="{StaticResource GreenColor}"
                                       HeightRequest="24" Margin="0,0,0,10"/>

                    <!-- Pedido gratuito: sin coste (solo visible cuando TotalEfectivo == 0) -->
                    <Border IsVisible="{Binding EsPedidoGratuito}"
                            BackgroundColor="#1a4caf82" StrokeThickness="1" Stroke="#4caf82"
                            Padding="18,16" Margin="0,0,0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="🍊" FontSize="28" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Desayuno gratuito" FontFamily="SyneBold" FontSize="14"
                                       TextColor="{StaticResource GreenColor}"/>
                                <Label Text="Tu pedido no tiene coste adicional"
                                       FontFamily="DMSans" FontSize="12"
                                       TextColor="{StaticResource GreenColor}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Pago con tarjeta: el formulario se muestra en el paso siguiente -->
                    <Border IsVisible="{Binding EsPedidoGratuito, Converter={StaticResource InvertBoolConverter}}"
                            BackgroundColor="{DynamicResource Surface2Color}"
                            StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                            Padding="18,16" Margin="0,0,0,14">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="💳" FontSize="28" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="Pago con tarjeta" FontFamily="SyneBold" FontSize="14"
                                       TextColor="{DynamicResource TextColor}"/>
                                <Label Text="Introducirás los datos en el siguiente paso"
                                       FontFamily="DMSans" FontSize="12"
                                       TextColor="{DynamicResource MutedColor}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Error de pago -->
                    <Border BackgroundColor="#26e05252" StrokeThickness="1" Stroke="#40e05252"
                            Padding="14,10" Margin="0,0,0,10" IsVisible="{Binding HayErrorPago}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Label Text="{Binding ErrorPago}" TextColor="{StaticResource RedColor}"
                               FontFamily="DMSans" FontSize="13"/>
                    </Border>

                    <!-- Estado del pago -->
                    <Label Text="{Binding EstadoPago}" FontFamily="SyneBold" FontSize="13"
                           TextColor="{StaticResource AccentColor}" HorizontalOptions="Center"
                           Margin="0,0,0,8" IsVisible="{Binding IsLoading}"/>

                    <!-- Botón pagar -->
                    <Button x:Name="BtnPagar"
                            Text="{Binding TotalEfectivo, StringFormat='Pagar {0:F2} €'}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ConfirmarPedidoCommand}"
                            IsEnabled="{Binding PuedePulsarPagar}"
                            Pressed="BtnPagar_Pressed"
                            Released="BtnPagar_Released"
                            SemanticProperties.Hint="Pulsa para confirmar y pagar el pedido"/>

                    <ActivityIndicator IsRunning="{Binding IsLoading}" Color="{StaticResource AccentColor}"
                                       Margin="0,8" IsVisible="{Binding IsLoading}"/>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>