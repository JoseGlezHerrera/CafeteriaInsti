<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ctrl="clr-namespace:CafeIES.MAUI.Controls"
             x:Class="CafeIES.MAUI.Views.AdminPedidosPage"
             x:DataType="vm:AdminPedidosViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}" Padding="20,16">
            <Label Text="Todos los pedidos" FontFamily="SyneBold" FontSize="22"
                   TextColor="{DynamicResource TextColor}"/>
        </Grid>

        <!-- Filtro por instituto -->
        <Border Grid.Row="1" BackgroundColor="{DynamicResource SurfaceColor}"
                StrokeThickness="0" Padding="16,0,16,12">
            <Border Style="{StaticResource InputBox}">
                <Picker ItemsSource="{Binding Institutos}"
                        ItemDisplayBinding="{Binding Nombre, x:DataType=dto:InstitutoDto}"
                        SelectedItem="{Binding FiltroInstituto}"
                        Title="Todos los centros"
                        TextColor="{DynamicResource TextColor}"
                        TitleColor="{DynamicResource MutedColor}"
                        FontFamily="DMSans" FontSize="14"/>
            </Border>
        </Border>

        <!-- Filtro por fecha -->
        <ScrollView Grid.Row="2" Orientation="Horizontal"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Padding="16,10,16,4" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Hoy"    Command="{Binding SetFiltroFechaCommand}" CommandParameter="Hoy"
                        Style="{Binding FiltroHoyActivo,    Converter={StaticResource BoolToChipStyleConverter}}"/>
                <Button Text="Semana" Command="{Binding SetFiltroFechaCommand}" CommandParameter="Semana"
                        Style="{Binding FiltroSemanaActivo, Converter={StaticResource BoolToChipStyleConverter}}"/>
                <Button Text="Todo"   Command="{Binding SetFiltroFechaCommand}" CommandParameter="Todo"
                        Style="{Binding FiltroTodoActivo,   Converter={StaticResource BoolToChipStyleConverter}}"/>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Filtro por estado -->
        <ScrollView Grid.Row="3" Orientation="Horizontal"
                    BackgroundColor="{DynamicResource SurfaceColor}"
                    Padding="16,4,16,14" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Todos"
                        Style="{Binding FiltroTodosActivo,     Converter={StaticResource BoolToChipStyleConverter}}"
                        Command="{Binding SetFiltroCommand}" CommandParameter=""/>
                <Button Text="Pendiente"
                        Style="{Binding FiltroPendienteActivo, Converter={StaticResource BoolToChipStyleConverter}}"
                        Command="{Binding SetFiltroCommand}" CommandParameter="Pendiente"/>
                <Button Text="En prep."
                        Style="{Binding FiltroEnPrepActivo,    Converter={StaticResource BoolToChipStyleConverter}}"
                        Command="{Binding SetFiltroCommand}" CommandParameter="EnPreparacion"/>
                <Button Text="Listo"
                        Style="{Binding FiltroListoActivo,     Converter={StaticResource BoolToChipStyleConverter}}"
                        Command="{Binding SetFiltroCommand}" CommandParameter="Listo"/>
                <Button Text="Entregado"
                        Style="{Binding FiltroEntregadoActivo, Converter={StaticResource BoolToChipStyleConverter}}"
                        Command="{Binding SetFiltroCommand}" CommandParameter="Entregado"/>
                <Button Text="Cancelado"
                        Style="{Binding FiltroCanceladoActivo, Converter={StaticResource BoolToChipStyleConverter}}"
                        Command="{Binding SetFiltroCommand}" CommandParameter="Cancelado"/>
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="4"
                     IsRefreshing="{Binding CargarCommand.IsRunning}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="{StaticResource AccentColor}">
            <CollectionView ItemsSource="{Binding Pedidos}" Margin="16,12">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="10" Margin="0,80">
                        <Label Text="Sin pedidos con este filtro"
                               Style="{StaticResource SubtitleLabel}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:PedidoDto">
                        <ctrl:PedidoCardView
                            ImprimirRequested="OnImprimirRequested"
                            PrepararRequested="OnPrepararRequested"
                            ListoRequested="OnListoRequested"
                            EntregarRequested="OnEntregarRequested"
                            CancelarRequested="OnCancelarRequested"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- D-1: Paginación — botón cargar más -->
                <CollectionView.Footer>
                    <VerticalStackLayout IsVisible="{Binding HayMas}" Padding="0,4,0,20">
                        <Button Text="Cargar más"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CargarMasCommand}"
                                IsEnabled="{Binding IsCargandoMas, Converter={StaticResource InvertBoolConverter}}"
                                HorizontalOptions="Center"
                                WidthRequest="180"/>
                        <ActivityIndicator IsRunning="{Binding IsCargandoMas}"
                                           IsVisible="{Binding IsCargandoMas}"
                                           Color="{StaticResource AccentColor}"
                                           Margin="0,4"/>
                    </VerticalStackLayout>
                </CollectionView.Footer>

            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
