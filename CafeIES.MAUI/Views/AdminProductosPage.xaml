<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.AdminProductosPage"
             x:DataType="vm:AdminProductosViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*">

        <!-- Header con boton nuevo -->
        <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}"
              Padding="20,16" ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Productos"
                   FontFamily="SyneBold" FontSize="22"
                   TextColor="{DynamicResource TextColor}"/>
            <Button Grid.Column="1" Text="+ Nuevo"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="38" FontSize="13" Padding="16,0"
                    Command="{Binding NuevoProductoCommand}"/>
        </Grid>

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="{StaticResource AccentColor}">
            <CollectionView ItemsSource="{Binding Productos}" Margin="16,12">

                <CollectionView.EmptyView>
                    <Label Text="Sin productos. Pulsa + Nuevo para crear uno."
                           Style="{StaticResource SubtitleLabel}"
                           HorizontalOptions="Center" Margin="0,60"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:ProductoDto">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                <!-- Info del producto -->
                                <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}"
                                           FontFamily="SyneBold" FontSize="15"
                                           TextColor="{DynamicResource TextColor}"/>
                                    <Label Text="{Binding CategoriaNombre}"
                                           FontFamily="DMSans" FontSize="12"
                                           TextColor="{DynamicResource MutedColor}"/>
                                    <HorizontalStackLayout Spacing="10">
                                        <Label FontFamily="SyneBold" FontSize="14"
                                               TextColor="{StaticResource AccentColor}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Precio, StringFormat='{0:F2}'}"/>
                                                    <Span Text=" EUR"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Border Padding="8,3"
                                                BackgroundColor="{Binding Activo, Converter={StaticResource ActivoBgConverter}}"
                                                StrokeThickness="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                            <Label Text="{Binding Activo, Converter={StaticResource ActivoTextoConverter}}"
                                                   FontFamily="SyneBold" FontSize="10"
                                                   TextColor="{Binding Activo, Converter={StaticResource ActivoTextColorConverter}}"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Botones accion -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Button Text="Editar"
                                            FontFamily="SyneBold" FontSize="11"
                                            BackgroundColor="{DynamicResource Surface2Color}"
                                            TextColor="{DynamicResource TextColor}"
                                            CornerRadius="10" HeightRequest="34" Padding="14,0"
                                            WidthRequest="82"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEditarClicked"/>
                                    <Button Text="{Binding Activo, Converter={StaticResource ActivoTextoConverter}}"
                                            FontFamily="SyneBold" FontSize="11"
                                            BackgroundColor="{Binding Activo, Converter={StaticResource ActivoBgConverter}}"
                                            TextColor="{Binding Activo, Converter={StaticResource ActivoTextColorConverter}}"
                                            CornerRadius="10" HeightRequest="34" Padding="14,0"
                                            WidthRequest="82"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnToggleActivoClicked"/>
                                    <Button Text="Eliminar"
                                            FontFamily="SyneBold" FontSize="11"
                                            BackgroundColor="#26e05252" TextColor="#e05252"
                                            CornerRadius="10" HeightRequest="34" Padding="14,0"
                                            WidthRequest="82"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnEliminarClicked"/>
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>
