<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CafeIES.MAUI.Views.ConfirmacionPedidoPage"
             BackgroundColor="{DynamicResource BgColor}"
             Shell.NavBarIsVisible="False">

    <VerticalStackLayout VerticalOptions="Center" Padding="40" Spacing="0">

        <!-- Animación checkmark -->
        <Border BackgroundColor="#1a4caf82" WidthRequest="100" HeightRequest="100"
                HorizontalOptions="Center" Margin="0,0,0,24">
            <Border.StrokeShape><Ellipse/></Border.StrokeShape>
            <Label Text="✓" FontFamily="SyneBold" FontSize="48"
                   TextColor="{StaticResource GreenColor}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

        <Label Text="¡Pedido realizado!" FontFamily="SyneBold" FontSize="30"
               TextColor="{DynamicResource TextColor}" HorizontalOptions="Center"
               Margin="0,0,0,8"/>
        <Label Text="Recoge en el mostrador cuando esté listo"
               Style="{StaticResource SubtitleLabel}" HorizontalOptions="Center"
               HorizontalTextAlignment="Center" Margin="0,0,0,40"/>

        <!-- Número de pedido grande -->
        <Border BackgroundColor="{DynamicResource Surface2Color}"
                StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                Padding="32,24" HorizontalOptions="FillAndExpand" Margin="0,0,0,40">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="TU NÚMERO" FontFamily="SyneBold" FontSize="11"
                       TextColor="{DynamicResource MutedColor}" CharacterSpacing="2"
                       HorizontalOptions="Center"/>
                <Label x:Name="NumeroPedidoLabel" FontFamily="SyneBold" FontSize="64"
                       TextColor="{StaticResource AccentColor}" HorizontalOptions="Center"/>
                <Label x:Name="TotalLabel" FontFamily="DMSans" FontSize="16"
                       TextColor="{DynamicResource MutedColor}" HorizontalOptions="Center"/>
            </VerticalStackLayout>
            <!-- El número aparece en cuanto el servidor confirma el pedido (~2s) -->
        </Border>

        <!-- Botón volver -->
        <Button Text="Ver mis pedidos" Style="{StaticResource PrimaryButton}"
                Clicked="OnVerPedidosClicked"/>
        <Button Text="Seguir pidiendo" Style="{StaticResource SecondaryButton}"
                Margin="0,12,0,0" Clicked="OnSeguirPidiendoClicked"/>

    </VerticalStackLayout>
</ContentPage>
