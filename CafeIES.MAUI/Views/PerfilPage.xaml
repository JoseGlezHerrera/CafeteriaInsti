<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             x:Class="CafeIES.MAUI.Views.PerfilPage"
             x:DataType="vm:PerfilViewModel"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="0">

            <!-- Header -->
            <Label Text="Perfil" FontFamily="SyneBold" FontSize="22"
                   TextColor="{StaticResource TextColor}" Margin="0,16,0,28"/>

            <!-- Avatar + nombre -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10" Margin="0,0,0,32">
                <Border BackgroundColor="{StaticResource Surface2Color}"
                        WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                    <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                    <Label Text="👤" FontSize="36"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Text="{Binding NombreCompleto}" FontFamily="SyneBold" FontSize="20"
                       TextColor="{StaticResource TextColor}" HorizontalOptions="Center"/>
                <Label Text="{Binding Email}" Style="{StaticResource SubtitleLabel}"
                       HorizontalOptions="Center"/>

                <!-- Rol + turno pills -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8" Margin="0,4,0,0">
                    <Border Padding="10,5" BackgroundColor="#1af5a623"
                            StrokeThickness="1" Stroke="#40f5a623">
                        <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                        <Label Text="{Binding RolTexto}" FontFamily="SyneBold" FontSize="12"
                               TextColor="{StaticResource AccentColor}"/>
                    </Border>
                    <Border Padding="10,5" BackgroundColor="{StaticResource Surface2Color}"
                            StrokeThickness="1" Stroke="{StaticResource BorderColor}"
                            IsVisible="{Binding TieneTurno}">
                        <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                        <Label Text="{Binding TurnoTexto}" FontFamily="SyneBold" FontSize="12"
                               TextColor="{StaticResource MutedColor}"/>
                    </Border>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Info estado horario (solo para alumnos/profesores/personal) -->
            <Border BackgroundColor="{StaticResource Surface2Color}"
                    StrokeThickness="1" Stroke="{StaticResource BorderColor}"
                    Padding="18,16" Margin="0,0,0,16"
                    IsVisible="{Binding EsEmpleadoCafeteria, Converter={StaticResource InvertBoolConverter}}">
                <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Label Grid.Column="0" Text="⏰" FontSize="22" VerticalOptions="Center"/>
                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="Horario de pedidos" FontFamily="SyneBold" FontSize="14"
                               TextColor="{StaticResource TextColor}"/>
                        <Label Text="{Binding ResumenHorario}" Style="{StaticResource CaptionLabel}"
                               LineBreakMode="WordWrap"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Estadísticas (solo para alumnos/profesores/personal) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,16"
                  IsVisible="{Binding EsEmpleadoCafeteria, Converter={StaticResource InvertBoolConverter}}">
                <Border Grid.Column="0" BackgroundColor="{StaticResource Surface2Color}"
                        StrokeThickness="1" Stroke="{StaticResource BorderColor}" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding TotalPedidos}" FontFamily="SyneBold" FontSize="28"
                               TextColor="{StaticResource AccentColor}"/>
                        <Label Text="Pedidos totales" Style="{StaticResource CaptionLabel}"/>
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Surface2Color}"
                        StrokeThickness="1" Stroke="{StaticResource BorderColor}" Padding="16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <Label FontFamily="SyneBold" FontSize="28" TextColor="{StaticResource AccentColor}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TotalGastado, StringFormat='{0:F0}'}"/>
                                    <Span Text="€"/>
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="Total gastado" Style="{StaticResource CaptionLabel}"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Cambiar contraseña (#6) -->
            <Button Text="🔑 Cambiar contraseña" Margin="0,8,0,0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ToggleCambioPasswordCommand}"/>

            <Border BackgroundColor="{StaticResource Surface2Color}"
                    StrokeThickness="1" Stroke="{StaticResource BorderColor}"
                    Padding="18,16" Margin="0,10,0,0"
                    IsVisible="{Binding MostrarCambioPassword}">
                <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cambiar contraseña" FontFamily="SyneBold" FontSize="14"
                           TextColor="{StaticResource TextColor}"/>
                    <Entry Placeholder="Contraseña actual" IsPassword="True"
                           Style="{StaticResource InputEntry}"
                           Text="{Binding PasswordActual}"/>
                    <Entry Placeholder="Nueva contraseña (mín. 8 caracteres)" IsPassword="True"
                           Style="{StaticResource InputEntry}"
                           Text="{Binding NuevaPassword}"/>
                    <Entry Placeholder="Confirmar nueva contraseña" IsPassword="True"
                           Style="{StaticResource InputEntry}"
                           Text="{Binding ConfirmarPassword}"/>
                    <Label Text="{Binding PasswordMessage}" FontFamily="DMSans" FontSize="12"
                           TextColor="{StaticResource RedColor}"
                           IsVisible="{Binding PasswordIsError}"/>
                    <Button Text="Guardar contraseña" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CambiarPasswordCommand}"/>
                </VerticalStackLayout>
            </Border>

            <!-- Cerrar sesión -->
            <Button Text="Cerrar sesión" Margin="0,24,0,0"
                    BackgroundColor="#26e05252" TextColor="{StaticResource RedColor}"
                    FontFamily="SyneBold" FontSize="15" HeightRequest="52" CornerRadius="16"
                    Command="{Binding CerrarSesionCommand}"/>

            <Label Text="CaféIES v1.0 · IES"
                   HorizontalOptions="Center" Margin="0,24,0,16"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
