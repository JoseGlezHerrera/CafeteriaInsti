<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.AdminUsuariosPage"
             x:DataType="vm:AdminUsuariosViewModel"
             BackgroundColor="{DynamicResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <!-- Root Grid: contenido principal + overlay + panel apilados -->
    <Grid>

        <!-- ══════════════════════════════════════════════════════════
             LAYER 1 — Contenido principal
        ═══════════════════════════════════════════════════════════ -->
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Header -->
            <Grid Grid.Row="0" BackgroundColor="{DynamicResource SurfaceColor}" Padding="20,16">
                <Label Text="Usuarios" FontFamily="SyneBold" FontSize="22"
                       TextColor="{DynamicResource TextColor}"/>
            </Grid>

            <!-- Filtros -->
            <VerticalStackLayout Grid.Row="1" BackgroundColor="{DynamicResource SurfaceColor}"
                                 Padding="16,0,16,14" Spacing="10">
                <Border StrokeThickness="1" Stroke="{DynamicResource BorderColor}"
                        BackgroundColor="{DynamicResource Surface2Color}" Padding="4,0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Style="{StaticResource InputEntry}" HeightRequest="42"
                           Placeholder="🔍  Buscar por nombre o email"
                           Text="{Binding TextoBusqueda}"/>
                </Border>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Todos"        Command="{Binding SetFiltroRolCommand}" CommandParameter="Todos"
                                Style="{Binding FiltroRolTodosActivo,    Converter={StaticResource BoolToChipStyleConverter}}"/>
                        <Button Text="🎓 Alumno"    Command="{Binding SetFiltroRolCommand}" CommandParameter="Alumno"
                                Style="{Binding FiltroRolAlumnoActivo,   Converter={StaticResource BoolToChipStyleConverter}}"/>
                        <Button Text="👨‍🏫 Profesor" Command="{Binding SetFiltroRolCommand}" CommandParameter="Profesor"
                                Style="{Binding FiltroRolProfesorActivo, Converter={StaticResource BoolToChipStyleConverter}}"/>
                        <Button Text="🏢 Personal"  Command="{Binding SetFiltroRolCommand}" CommandParameter="Personal"
                                Style="{Binding FiltroRolPersonalActivo, Converter={StaticResource BoolToChipStyleConverter}}"/>
                        <Button Text="☕ Empleado"  Command="{Binding SetFiltroRolCommand}" CommandParameter="Empleado"
                                Style="{Binding FiltroRolEmpleadoActivo, Converter={StaticResource BoolToChipStyleConverter}}"/>
                    </HorizontalStackLayout>
                </ScrollView>
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Todos"          Command="{Binding SetFiltroEstadoCommand}" CommandParameter="Todos"
                                Style="{Binding FiltroEstadoTodosActivo,      Converter={StaticResource BoolToChipStyleConverter}}"/>
                        <Button Text="✅ Activos"     Command="{Binding SetFiltroEstadoCommand}" CommandParameter="Activa"
                                Style="{Binding FiltroEstadoActivoActivo,     Converter={StaticResource BoolToChipStyleConverter}}"/>
                        <Button Text="🚫 Suspendidos" Command="{Binding SetFiltroEstadoCommand}" CommandParameter="Suspendida"
                                Style="{Binding FiltroEstadoSuspendidoActivo, Converter={StaticResource BoolToChipStyleConverter}}"/>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <!-- Lista -->
            <RefreshView Grid.Row="2"
                         IsRefreshing="{Binding IsLoading}"
                         Command="{Binding CargarCommand}">
                <ScrollView>
                    <VerticalStackLayout Padding="16,12" Spacing="16">

                        <!-- Pendientes -->
                        <VerticalStackLayout IsVisible="{Binding HayPendientes}" Spacing="10">
                            <Grid ColumnDefinitions="3,*" ColumnSpacing="10" HeightRequest="26">
                                <BoxView Grid.Column="0" Color="#f5a623" CornerRadius="2"/>
                                <Label   Grid.Column="1" Text="Pendientes de validación"
                                         FontFamily="SyneBold" FontSize="16"
                                         TextColor="#f5a623" VerticalOptions="Center"/>
                            </Grid>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pendientes}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:UsuarioDto">
                                        <Border x:Name="TarjetaPendiente"
                                                Style="{StaticResource Card}" Margin="0,0,0,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnTarjetaTapped"/>
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                    <Label Text="{Binding NombreCompleto}"
                                                           FontFamily="SyneBold" FontSize="14"
                                                           TextColor="{DynamicResource TextColor}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Email}"
                                                           FontFamily="DMSans" FontSize="12"
                                                           TextColor="{DynamicResource MutedColor}"
                                                           LineBreakMode="TailTruncation"/>
                                                    <Label Text="{Binding Rol, Converter={StaticResource RolTextoConverter}}"
                                                           FontFamily="DMSans" FontSize="11"
                                                           TextColor="{DynamicResource MutedColor}"/>
                                                </VerticalStackLayout>
                                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                    <Border BackgroundColor="#26f5a623"
                                                            Padding="8,3" StrokeThickness="0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                                        <Label Text="Pendiente" FontFamily="SyneBold" FontSize="10" TextColor="#f5a623"/>
                                                    </Border>
                                                    <Label Text="›" FontSize="20" TextColor="{DynamicResource MutedColor}"
                                                           HorizontalOptions="Center"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Todos los usuarios -->
                        <Grid ColumnDefinitions="3,*" ColumnSpacing="10" Margin="0,8,0,0" HeightRequest="26">
                            <BoxView Grid.Column="0" Color="{DynamicResource MutedColor}" CornerRadius="2"/>
                            <Label   Grid.Column="1" Text="Todos los usuarios"
                                     FontFamily="SyneBold" FontSize="16"
                                     TextColor="{DynamicResource MutedColor}" VerticalOptions="Center"/>
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Todos}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:UsuarioDto">
                                    <Border x:Name="TarjetaUsuario"
                                            Style="{StaticResource Card}" Margin="0,0,0,8"
                                            Stroke="{Binding Estado, Converter={StaticResource EstadoCuentaBorderConverter}}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTarjetaTapped"/>
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding NombreCompleto}"
                                                       FontFamily="SyneBold" FontSize="14"
                                                       TextColor="{DynamicResource TextColor}"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Email}"
                                                       FontFamily="DMSans" FontSize="12"
                                                       TextColor="{DynamicResource MutedColor}"
                                                       LineBreakMode="TailTruncation"/>
                                                <HorizontalStackLayout Spacing="6" Margin="0,2,0,0">
                                                    <Label Text="{Binding Rol, Converter={StaticResource RolTextoConverter}}"
                                                           FontFamily="DMSans" FontSize="11"
                                                           TextColor="{DynamicResource MutedColor}"/>
                                                    <!-- Indicador desayuno gratuito en la tarjeta -->
                                                    <Label Text="🍊"
                                                           FontSize="11"
                                                           IsVisible="{Binding DesayunoGratuito}"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                                <Border BackgroundColor="{Binding Estado, Converter={StaticResource EstadoCuentaBgConverter}}"
                                                        Padding="8,3" StrokeThickness="0" HorizontalOptions="End">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                                    <Label Text="{Binding Estado, Converter={StaticResource EstadoCuentaTextoConverter}}"
                                                           FontFamily="SyneBold" FontSize="10"
                                                           TextColor="{Binding Estado, Converter={StaticResource EstadoCuentaTextColorConverter}}"/>
                                                </Border>
                                                <Label Text="›" FontSize="20" TextColor="{DynamicResource MutedColor}"
                                                       HorizontalOptions="Center"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

        </Grid>

        <!-- ══════════════════════════════════════════════════════════
             LAYER 2 — Overlay oscuro (cubre todo al abrir el panel)
        ═══════════════════════════════════════════════════════════ -->
        <BoxView x:Name="Overlay"
                 Color="Black" Opacity="0" IsVisible="False"
                 InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnOverlayTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ══════════════════════════════════════════════════════════
             LAYER 3 — Panel contextual (bottom sheet)
        ═══════════════════════════════════════════════════════════ -->
        <Border x:Name="PanelContextual"
                BackgroundColor="{DynamicResource SurfaceColor}"
                VerticalOptions="End"
                TranslationY="700"
                Opacity="0"
                IsVisible="False"
                StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>

            <VerticalStackLayout Spacing="0">

                <!-- Handle bar -->
                <BoxView HeightRequest="4" WidthRequest="40" CornerRadius="2"
                         Color="{DynamicResource BorderColor}"
                         HorizontalOptions="Center" Margin="0,14,0,18"/>

                <!-- Info del usuario seleccionado -->
                <Grid ColumnDefinitions="56,*" ColumnSpacing="14" Padding="20,0,20,16">
                    <!-- Avatar -->
                    <Border BackgroundColor="{DynamicResource Surface2Color}"
                            WidthRequest="52" HeightRequest="52"
                            StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><Ellipse/></Border.StrokeShape>
                        <Label Text="👤" FontSize="24"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <!-- Nombre, email, badges -->
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding UsuarioSeleccionado.NombreCompleto}"
                               FontFamily="SyneBold" FontSize="16"
                               TextColor="{DynamicResource TextColor}"
                               LineBreakMode="TailTruncation"/>
                        <Label Text="{Binding UsuarioSeleccionado.Email}"
                               FontFamily="DMSans" FontSize="12"
                               TextColor="{DynamicResource MutedColor}"
                               LineBreakMode="TailTruncation"/>
                        <HorizontalStackLayout Spacing="6" Margin="0,3,0,0">
                            <Border BackgroundColor="{DynamicResource Surface2Color}"
                                    Padding="8,3" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                <Label Text="{Binding UsuarioSeleccionado.Rol, Converter={StaticResource RolTextoConverter}}"
                                       FontFamily="SyneBold" FontSize="10"
                                       TextColor="{DynamicResource MutedColor}"/>
                            </Border>
                            <Border BackgroundColor="{Binding UsuarioSeleccionado.Estado, Converter={StaticResource EstadoCuentaBgConverter}}"
                                    Padding="8,3" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="50"/></Border.StrokeShape>
                                <Label Text="{Binding UsuarioSeleccionado.Estado, Converter={StaticResource EstadoCuentaTextoConverter}}"
                                       FontFamily="SyneBold" FontSize="10"
                                       TextColor="{Binding UsuarioSeleccionado.Estado, Converter={StaticResource EstadoCuentaTextColorConverter}}"/>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Grid>

                <!-- Separador -->
                <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" Margin="20,0,20,12"/>

                <!-- Botones de acción -->
                <VerticalStackLayout Padding="16,0" Spacing="8">

                    <!-- Aprobar (pendientes) -->
                    <Button Text="✓  Aprobar solicitud"
                            IsVisible="{Binding PanelPuedeAprobar}"
                            BackgroundColor="#1f4caf82" TextColor="#4caf82"
                            FontFamily="SyneBold" FontSize="14"
                            CornerRadius="14" HeightRequest="50"
                            Clicked="OnPanelAprobarClicked"/>

                    <!-- Rechazar (pendientes) -->
                    <Button Text="✕  Rechazar solicitud"
                            IsVisible="{Binding PanelPuedeAprobar}"
                            BackgroundColor="#1fe05252" TextColor="#e05252"
                            FontFamily="SyneBold" FontSize="14"
                            CornerRadius="14" HeightRequest="50"
                            Clicked="OnPanelRechazarClicked"/>

                    <!-- Desayuno gratuito (alumnos activos) -->
                    <Button IsVisible="{Binding PanelPuedeDesayuno}"
                            Text="{Binding PanelDesayunoTexto}"
                            BackgroundColor="{Binding PanelDesayunoActivo, Converter={StaticResource ActivoBgConverter}}"
                            TextColor="{Binding PanelDesayunoActivo, Converter={StaticResource ActivoTextColorConverter}}"
                            FontFamily="SyneBold" FontSize="14"
                            CornerRadius="14" HeightRequest="50"
                            Clicked="OnPanelDesayunoClicked"/>

                    <!-- Suspender (activos no-admin) -->
                    <Button Text="🔒  Suspender cuenta"
                            IsVisible="{Binding PanelPuedeSuspender}"
                            BackgroundColor="#1fe05252" TextColor="#e05252"
                            FontFamily="SyneBold" FontSize="14"
                            CornerRadius="14" HeightRequest="50"
                            Clicked="OnPanelSuspenderClicked"/>

                    <!-- Reactivar (suspendidos / rechazados) -->
                    <Button Text="✅  Reactivar cuenta"
                            IsVisible="{Binding PanelPuedeReactivar}"
                            BackgroundColor="#1f4caf82" TextColor="#4caf82"
                            FontFamily="SyneBold" FontSize="14"
                            CornerRadius="14" HeightRequest="50"
                            Clicked="OnPanelReactivarClicked"/>

                    <!-- Eliminar (no-admin) -->
                    <Button Text="🗑  Eliminar usuario"
                            IsVisible="{Binding PanelPuedeEliminar}"
                            BackgroundColor="Transparent" TextColor="#e05252"
                            BorderColor="#33e05252" BorderWidth="1"
                            FontFamily="SyneBold" FontSize="14"
                            CornerRadius="14" HeightRequest="50"
                            Clicked="OnPanelEliminarClicked"/>

                </VerticalStackLayout>

                <!-- Cerrar -->
                <Button Text="Cancelar"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource MutedColor}"
                        FontFamily="DMSans" FontSize="14"
                        Margin="16,6,16,36"
                        Clicked="OnCerrarPanelClicked"/>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
