<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CafeIES.MAUI.ViewModels"
             xmlns:dto="clr-namespace:CafeIES.Shared.Models;assembly=CafeIES.Shared"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CafeIES.MAUI.Views.AdminHorariosPage"
             x:DataType="vm:AdminHorariosViewModel"
             BackgroundColor="{StaticResource BgColor}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding CargarCommand}"/>
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource SurfaceColor}" Padding="16,14"
              ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                    Text="←"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" WidthRequest="44" Padding="0"
                    Command="{Binding VolverCommand}"/>
            <Label Grid.Column="1" Text="Franjas horarias" FontFamily="SyneBold" FontSize="20"
                   TextColor="{StaticResource TextColor}" VerticalOptions="Center" Margin="12,0,0,0"/>
            <Button Grid.Column="2"
                    Text="+ Nueva"
                    Style="{StaticResource SecondaryButton}"
                    HeightRequest="38" Padding="14,0"
                    Command="{Binding NuevaFranjaCommand}"/>
        </Grid>

        <!-- Lista -->
        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding CargarCommand}"
                     RefreshColor="{StaticResource AccentColor}">
            <CollectionView ItemsSource="{Binding Franjas}" Margin="16,12">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                                         Spacing="10" Margin="0,80">
                        <Label Text="⏰" FontSize="44" HorizontalOptions="Center"/>
                        <Label Text="Sin franjas horarias configuradas"
                               Style="{StaticResource SubtitleLabel}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:FranjaHorariaDto">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="#e05252"
                                               CommandParameter="{Binding .}"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminHorariosViewModel}}, Path=EliminarFranjaCommand}"/>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Style="{StaticResource Card}">
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="10">

                                    <!-- Cabecera: descripcion + badge turno + switch activa -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <!-- Badge turno -->
                                        <Border Grid.Column="0" Padding="10,5"
                                                BackgroundColor="#1af5a623" StrokeThickness="0">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                            <Label Text="{Binding Turno, Converter={StaticResource TurnoDisplayConverter}}"
                                                   FontFamily="SyneBold" FontSize="12"
                                                   TextColor="{StaticResource AccentColor}"/>
                                        </Border>
                                        <!-- Descripción -->
                                        <Label Grid.Column="1"
                                               Text="{Binding Descripcion}"
                                               FontFamily="SyneBold" FontSize="14"
                                               TextColor="{StaticResource TextColor}"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"/>
                                        <!-- Switch activa -->
                                        <Switch Grid.Column="2"
                                                IsToggled="{Binding Activa, Mode=OneWay}"
                                                OnColor="{StaticResource AccentColor}"
                                                ThumbColor="{StaticResource TextColor}"
                                                VerticalOptions="Center"/>
                                    </Grid>

                                    <!-- Horario + badge bloqueada/permitida -->
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Label Grid.Column="0"
                                               FontFamily="SyneBold" FontSize="15"
                                               TextColor="{StaticResource AccentColor}"
                                               VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding HoraInicio}"/>
                                                    <Span Text=" – "/>
                                                    <Span Text="{Binding HoraFin}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <!-- Botón editar -->
                                        <Button Grid.Column="1"
                                                Text="Editar"
                                                FontFamily="SyneBold" FontSize="11"
                                                BackgroundColor="#26f5a623" TextColor="{StaticResource AccentColor}"
                                                CornerRadius="10" HeightRequest="34" Padding="12,0"
                                                HorizontalOptions="End"
                                                CommandParameter="{Binding .}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AdminHorariosViewModel}}, Path=EditarFranjaCommand}"/>
                                    </Grid>

                                </Grid>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Error -->
        <Border Grid.Row="2"
                BackgroundColor="#1ae05252"
                StrokeThickness="1" Stroke="#40e05252"
                Padding="16,12" Margin="16,0,16,16"
                IsVisible="{Binding HasError}">
            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
            <Label Text="{Binding Error}"
                   FontFamily="DMSans" FontSize="13"
                   TextColor="#e05252"/>
        </Border>

    </Grid>
</ContentPage>
