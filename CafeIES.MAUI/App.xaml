<?xml version="1.0" encoding="utf-8"?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:CafeIES.MAUI.Converters"
             x:Class="CafeIES.MAUI.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Converters ──────────────────────────────────────────────── -->
            <conv:InvertBoolConverter x:Key="InvertBoolConverter"/>
            <conv:IntToBoolConverter x:Key="IntToBoolConverter"/>
            <conv:BoolToAccentBorderConverter x:Key="BoolToAccentBorderConverter"/>
            <conv:BoolToAccentBgConverter x:Key="BoolToAccentBgConverter"/>
            <conv:BoolToAccentTextConverter x:Key="BoolToAccentTextConverter"/>
            <conv:StockLevelBorderConverter x:Key="StockLevelBorderConverter"/>
            <conv:StockLevelTextConverter x:Key="StockLevelTextConverter"/>
            <conv:StockLevelEmojiConverter x:Key="StockLevelEmojiConverter"/>
            <conv:StockDisplayConverter x:Key="StockDisplayConverter"/>
            <conv:EstadoPedidoBgConverter x:Key="EstadoPedidoBgConverter"/>
            <conv:EstadoPedidoBorderConverter x:Key="EstadoPedidoBorderConverter"/>
            <conv:EstadoPedidoLabelConverter x:Key="EstadoPedidoLabelConverter"/>
            <conv:EstadoPedidoTextConverter x:Key="EstadoPedidoTextConverter"/>
            <conv:LineasResumenConverter x:Key="LineasResumenConverter"/>
            <conv:EstadoEsConverter x:Key="EstadoEsConverter"/>
            <conv:EstadoCancelableConverter x:Key="EstadoCancelableConverter"/>
            <conv:EstadoCuentaTextoConverter x:Key="EstadoCuentaTextoConverter"/>
            <conv:EstadoCuentaBgConverter x:Key="EstadoCuentaBgConverter"/>
            <conv:EstadoCuentaTextColorConverter x:Key="EstadoCuentaTextColorConverter"/>
            <conv:EstadoCuentaBorderConverter x:Key="EstadoCuentaBorderConverter"/>
            <conv:RolTextoConverter x:Key="RolTextoConverter"/>
            <conv:ActivoTextoConverter x:Key="ActivoTextoConverter"/>
            <conv:ActivoBgConverter x:Key="ActivoBgConverter"/>
            <conv:ActivoTextColorConverter x:Key="ActivoTextColorConverter"/>
            <conv:RolNoEsAdminConverter x:Key="RolNoEsAdminConverter"/>
            <conv:RolEsAlumnoConverter x:Key="RolEsAlumnoConverter"/>
            <conv:AlergenosToEmojiConverter x:Key="AlergenosToEmojiConverter"/>
            <conv:AlergenosVisibleConverter x:Key="AlergenosVisibleConverter"/>
            <conv:StockAcabadoConverter x:Key="StockAcabadoConverter"/>
            <conv:StockDisponibleConverter x:Key="StockDisponibleConverter"/>
            <conv:StockToOpacityConverter x:Key="StockToOpacityConverter"/>
            <conv:InvitacionEstadoConverter x:Key="InvitacionEstadoConverter"/>
            <conv:TurnoDisplayConverter x:Key="TurnoDisplayConverter"/>
            <conv:BoolToChipStyleConverter x:Key="BoolToChipStyleConverter"/>
            <conv:UtcToLocalDateTimeConverter x:Key="UtcToLocalDateTimeConverter"/>

            <!-- ── Estilos base ────────────────────────────────────────────── -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{DynamicResource BgColor}"/>
            </Style>

            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontFamily"  Value="SyneBold"/>
                <Setter Property="TextColor"   Value="{DynamicResource TextColor}"/>
                <Setter Property="FontSize"    Value="28"/>
            </Style>

            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="DMSans"/>
                <Setter Property="TextColor"  Value="{DynamicResource MutedColor}"/>
                <Setter Property="FontSize"   Value="14"/>
            </Style>

            <Style x:Key="BodyLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="DMSans"/>
                <Setter Property="TextColor"  Value="{DynamicResource TextColor}"/>
                <Setter Property="FontSize"   Value="15"/>
            </Style>

            <Style x:Key="CaptionLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="DMSans"/>
                <Setter Property="TextColor"  Value="{DynamicResource MutedColor}"/>
                <Setter Property="FontSize"   Value="12"/>
            </Style>

            <!-- Input estilizado -->
            <Style x:Key="InputEntry" TargetType="Entry">
                <Setter Property="BackgroundColor"  Value="{DynamicResource Surface2Color}"/>
                <Setter Property="TextColor"        Value="{DynamicResource TextColor}"/>
                <Setter Property="PlaceholderColor" Value="{DynamicResource MutedColor}"/>
                <Setter Property="FontFamily"       Value="DMSans"/>
                <Setter Property="FontSize"         Value="15"/>
                <Setter Property="HeightRequest"    Value="52"/>
                <Setter Property="Margin"           Value="0,4"/>
            </Style>

            <!-- Botón primario dorado -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}"/>
                <Setter Property="TextColor"       Value="#1A1614"/>
                <Setter Property="FontFamily"      Value="SyneBold"/>
                <Setter Property="FontSize"        Value="15"/>
                <Setter Property="HeightRequest"   Value="54"/>
                <Setter Property="CornerRadius"    Value="16"/>
                <Setter Property="FontAttributes"  Value="Bold"/>
            </Style>

            <!-- Botón secundario (borde) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor"    Value="Transparent"/>
                <Setter Property="TextColor"          Value="{StaticResource AccentColor}"/>
                <Setter Property="BorderColor"        Value="{StaticResource AccentColor}"/>
                <Setter Property="BorderWidth"        Value="1.5"/>
                <Setter Property="FontFamily"         Value="SyneBold"/>
                <Setter Property="FontSize"           Value="14"/>
                <Setter Property="HeightRequest"      Value="52"/>
                <Setter Property="CornerRadius"       Value="16"/>
            </Style>

            <!-- Botón chip / filtro pill -->
            <Style x:Key="ChipButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{DynamicResource Surface2Color}"/>
                <Setter Property="TextColor"       Value="{DynamicResource MutedColor}"/>
                <Setter Property="BorderColor"     Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderWidth"     Value="1"/>
                <Setter Property="FontFamily"      Value="SyneBold"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="HeightRequest"   Value="36"/>
                <Setter Property="CornerRadius"    Value="50"/>
                <Setter Property="Padding"         Value="16,0"/>
            </Style>

            <!-- Botón chip activo (acento dorado) -->
            <Style x:Key="ChipButtonActive" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#26f5a623"/>
                <Setter Property="TextColor"       Value="{StaticResource AccentColor}"/>
                <Setter Property="BorderColor"     Value="{StaticResource AccentColor}"/>
                <Setter Property="BorderWidth"     Value="1.5"/>
                <Setter Property="FontFamily"      Value="SyneBold"/>
                <Setter Property="FontSize"        Value="12"/>
                <Setter Property="HeightRequest"   Value="36"/>
                <Setter Property="CornerRadius"    Value="50"/>
                <Setter Property="Padding"         Value="16,0"/>
            </Style>

            <!-- Card -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor"   Value="{DynamicResource CardColor}"/>
                <Setter Property="Padding"           Value="16"/>
                <Setter Property="StrokeThickness"   Value="1"/>
                <Setter Property="Stroke"            Value="{DynamicResource BorderColor}"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="20"/>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
