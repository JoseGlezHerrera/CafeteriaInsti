<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-windows10.0.19041.0</TargetFrameworks>
		<RootNamespace>CafeIES.MAUI</RootNamespace>
		<ApplicationId>es.cafeies.app</ApplicationId>
		<ApplicationTitle>PikUp</ApplicationTitle>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseMaui>true</UseMaui>
		<!-- Habilita compilación de bindings con Source (RelativeSource AncestorType, etc.) — elimina XC0025 -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<SingleProject>true</SingleProject>
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>
		<!-- Permite ejecutar sin despliegue MSIX en Windows -->
		<WindowsPackageType>None</WindowsPackageType>
	</PropertyGroup>

	<!--
	  ── Android Release — firma y empaquetado para Play Store ────────────────────
	  Credenciales via variables de entorno (no se suben a git):
	    CAFEIES_KEYSTORE_PATH  → ruta al archivo .keystore (ej: C:\keys\cafeies-release.keystore)
	    CAFEIES_STORE_PASS     → contraseña del keystore
	    CAFEIES_KEY_PASS       → contraseña de la clave (puede ser igual a la del keystore)
	  Generar con: infra/generar-keystore.ps1
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND $(TargetFramework.StartsWith('net9.0-android'))">
		<!-- AAB (Android App Bundle) — requerido por Play Store desde agosto 2021 -->
		<AndroidPackageFormat>aab</AndroidPackageFormat>
		<!-- Firma del bundle -->
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(CAFEIES_KEYSTORE_PATH)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>cafeies</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>$(CAFEIES_KEY_PASS)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(CAFEIES_STORE_PASS)</AndroidSigningStorePass>
		<!-- Enlazador: elimina código no utilizado (reduce tamaño del bundle) -->
		<MauiLinkMode>SdkAndUserAssemblies</MauiLinkMode>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="CommunityToolkit.Maui" Version="9.0.3" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
	</ItemGroup>

	<!-- Push notifications: deshabilitado hasta configurar Firebase
	     Para activar: crear proyecto en Firebase Console, reemplazar google-services.json y
	     descomentar la siguiente sección.
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android')) OR $(TargetFramework.StartsWith('net9.0-ios'))">
		<PackageReference Include="Plugin.Firebase.CloudMessaging" Version="3.0.2" />
	</ItemGroup>
	-->

	<ItemGroup>
		<ProjectReference Include="..\CafeIES.Shared\CafeIES.Shared.csproj" />
	</ItemGroup>

	<!-- Firebase configuration files — descomentar cuando google-services.json sea real
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
		<GoogleServicesJson Include="Platforms\Android\google-services.json" />
	</ItemGroup>
	-->

	<!-- ProGuard / R8 para Release Android -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
		<ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
	</ItemGroup>
	<!-- iOS Firebase config — descomentar cuando GoogleService-Info.plist sea real
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-ios'))">
		<BundleResource Include="Platforms\iOS\GoogleService-Info.plist" />
	</ItemGroup>
	-->

	<!-- Fonts: explicit declaration ensures they are bundled on all targets -->
	<ItemGroup>
		<MauiFont Include="Resources\Fonts\Syne-Bold.ttf" />
		<MauiFont Include="Resources\Fonts\Syne-Regular.ttf" />
		<MauiFont Include="Resources\Fonts\DMSans-Regular.ttf" />
		<MauiFont Include="Resources\Fonts\DMSans-Medium.ttf" />
	</ItemGroup>

	<!-- Tab bar icons: explicit BaseSize required for correct SVG→PNG conversion -->
	<ItemGroup>
		<MauiImage Include="Resources\Images\icon_home.svg"      BaseSize="24,24" />
		<MauiImage Include="Resources\Images\icon_cart.svg"      BaseSize="24,24" />
		<MauiImage Include="Resources\Images\icon_orders.svg"    BaseSize="24,24" />
		<MauiImage Include="Resources\Images\icon_profile.svg"   BaseSize="24,24" />
		<MauiImage Include="Resources\Images\icon_productos.svg" BaseSize="24,24" />
		<MauiImage Include="Resources\Images\icon_usuarios.svg"  BaseSize="24,24" />
		<MauiImage Include="Resources\Images\icon_admin.svg"     BaseSize="24,24" />
	</ItemGroup>
</Project>
