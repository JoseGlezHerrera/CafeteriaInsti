<?xml version="1.0" encoding="utf-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:CafeIES.MAUI.Views"
       x:Class="CafeIES.MAUI.AppShell"
       Shell.FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarForegroundColor="#f5a623"
       Shell.TabBarTitleColor="#f5a623">

    <!-- Ruta de auth (sin tab bar) -->
    <ShellContent Route="Login" ContentTemplate="{DataTemplate views:LoginPage}" Shell.NavBarIsVisible="False"/>

    <!-- Panel de administración -->
    <TabBar Route="Admin">
        <Tab Title="Pedidos" Icon="icon_orders.png" Route="AdminPedidos">
            <ShellContent ContentTemplate="{DataTemplate views:AdminPedidosPage}"/>
        </Tab>
        <Tab Title="Productos" Icon="icon_productos.png" Route="AdminProductos">
            <ShellContent ContentTemplate="{DataTemplate views:AdminProductosPage}"/>
        </Tab>
        <Tab Title="Usuarios" Icon="icon_usuarios.png" Route="AdminUsuarios">
            <ShellContent ContentTemplate="{DataTemplate views:AdminUsuariosPage}"/>
        </Tab>
        <Tab Title="Perfil" Icon="icon_admin.png" Route="AdminPerfil">
            <ShellContent ContentTemplate="{DataTemplate views:AdminPerfilPage}"/>
        </Tab>
    </TabBar>

    <!-- Panel de empleado de cafetería -->
    <TabBar Route="Empleado">
        <Tab Title="Pedidos" Icon="icon_orders.png" Route="EmpleadoPedidos">
            <ShellContent ContentTemplate="{DataTemplate views:EmpleadoPedidosPage}"/>
        </Tab>
        <Tab Title="Productos" Icon="icon_productos.png" Route="EmpleadoProductos">
            <ShellContent ContentTemplate="{DataTemplate views:EmpleadoProductosPage}"/>
        </Tab>
        <Tab Title="Perfil" Icon="icon_profile.png" Route="EmpleadoPerfil">
            <ShellContent ContentTemplate="{DataTemplate views:PerfilPage}"/>
        </Tab>
    </TabBar>

    <!-- App principal con Tab Bar -->
    <TabBar Route="Main">
        <Tab Title="Inicio" Icon="icon_home.png" Route="Inicio">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}"/>
        </Tab>
        <Tab Title="Carrito" Icon="icon_cart.png" Route="Carrito">
            <ShellContent ContentTemplate="{DataTemplate views:CarritoPage}"/>
        </Tab>
        <Tab Title="Pedidos" Icon="icon_orders.png" Route="Pedidos">
            <ShellContent ContentTemplate="{DataTemplate views:PedidosPage}"/>
        </Tab>
        <Tab Title="Perfil" Icon="icon_profile.png" Route="Perfil">
            <ShellContent ContentTemplate="{DataTemplate views:PerfilPage}"/>
        </Tab>
    </TabBar>

    <!-- Rutas de navegación extra -->
</Shell>
