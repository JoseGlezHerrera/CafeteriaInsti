## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# MAUI bin/obj
[Bb]in/
[Oo]bj/
build/
app_packages/

# .NET
*.user
*.suo
*.cache
*.pdb
*.mdb
*.dll
*.exe
*.log
*.config
*.mdb

# VS
.vs/
*.vcxproj.user
*.vscode/*

# Mac files
.DS_Store
*.ipa

# Android
*.apk
*.aab
*.ap_
*.dex
*.class
*.keystore
*.gradle
.gradle/
local.properties
*.manifest
*.so

# iOS
*.xcuserstate
*.xcworkspace
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.plist
!**/GoogleService-Info.plist
!**/Platforms/iOS/Info.plist

# Windows
*.appxbundle
*.appx
*.msix
*.msixbundle
*.msixupload
AppPackages/

# Secrets - NEVER commit real API keys
appsettings.Development.json

# Node (if using webview with JS)
node_modules/

# Maui Assets build
Resources/Raw/*.zip
Platforms/Windows/appx/**
Platforms/Windows/BundleArtifacts/**

# Crash logs
*.mlcfg
*.crash
*.dmp
*.stacktrace

# Publish artifacts
publish/
# Ignorar wwwroot generados (MAUI, outputs de build) pero NO el de Admin (tiene CSS fuente)
wwwroot/
!CafeIES.Admin/wwwroot/
# appsettings.json lo inyecta CI/CD desde secretos — no debe estar en repo
CafeIES.Admin/wwwroot/appsettings.json

# User secrets
secrets.json
*.env
.env.*

# Claude Code memory
.claude/

# Credenciales locales del keystore Android (generadas por infra/generar-keystore.ps1)
infra/keystore-credentials.local.txt
infra/cafeies-release.keystore
