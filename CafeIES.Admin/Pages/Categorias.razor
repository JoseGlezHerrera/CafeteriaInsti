@page "/categorias"
@inject AdminApiService Api

<PageTitle>Categorías · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Categorías</h1>
    <button class="btn-primary" @onclick="AbrirNueva">+ Nueva categoría</button>
</div>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Emoji</th>
                <th>Nombre</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in _categorias)
            {
                <tr>
                    <td><span style="font-size:24px">@cat.Emoji</span></td>
                    <td><strong>@cat.Nombre</strong></td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn-icon" title="Editar"
                                    @onclick="() => AbrirEditar(cat)">✏️</button>
                            <button class="btn-icon btn-icon--danger" title="Eliminar"
                                    @onclick="() => EliminarCategoria(cat.Id)">🗑</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_mostrarModal)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editandoId.HasValue ? "Editar categoría" : "Nueva categoría")</h3>
                <button class="modal-close" @onclick="CerrarModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group" style="flex:0 0 80px">
                        <label>Emoji</label>
                        <input class="form-input" @bind="_emoji" placeholder="🍕" maxlength="4"/>
                    </div>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input class="form-input" @bind="_nombre" placeholder="ej. Bocadillos"/>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p style="color:var(--red);font-size:13px;margin-top:8px">⚠️ @_error</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button class="btn-primary" @onclick="Guardar" disabled="@_guardando">
                    @(_guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<CategoriaDto> _categorias = new();
    private bool   _mostrarModal = false;
    private bool   _guardando    = false;
    private int?   _editandoId;
    private string _nombre = string.Empty;
    private string _emoji  = string.Empty;
    private string _error  = string.Empty;

    protected override async Task OnInitializedAsync()
        => _categorias = await Api.GetCategoriasAsync();

    private void AbrirNueva()
    {
        _editandoId = null;
        _nombre = string.Empty;
        _emoji  = string.Empty;
        _error  = string.Empty;
        _mostrarModal = true;
    }

    private void AbrirEditar(CategoriaDto cat)
    {
        _editandoId = cat.Id;
        _nombre     = cat.Nombre;
        _emoji      = cat.Emoji;
        _error      = string.Empty;
        _mostrarModal = true;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_emoji))
        {
            _error = "El nombre y el emoji son obligatorios.";
            return;
        }

        _guardando = true;
        _error     = string.Empty;

        bool ok = _editandoId.HasValue
            ? await Api.ActualizarCategoriaAsync(_editandoId.Value, _nombre.Trim(), _emoji.Trim())
            : await Api.CrearCategoriaAsync(_nombre.Trim(), _emoji.Trim());

        _guardando = false;

        if (!ok) { _error = "Error al guardar. Inténtalo de nuevo."; return; }

        _categorias   = await Api.GetCategoriasAsync();
        _mostrarModal = false;
    }

    private async Task EliminarCategoria(int id)
    {
        await Api.EliminarCategoriaAsync(id);
        _categorias = await Api.GetCategoriasAsync();
    }

    private void CerrarModal() => _mostrarModal = false;
}
