@page "/desayunos"
@inject AdminApiService Api
@using System.Text.Json

<PageTitle>Desayunos gratuitos · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Desayunos gratuitos 🍊</h1>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     SECCIÓN 1 — Gestión de beneficiarios
════════════════════════════════════════════════════════════════════════════ -->
<div class="section" style="margin-bottom:40px">
    <div class="section-header">
        <h2>Beneficiarios</h2>
        <div class="filters-inline">
            <input class="search-input" placeholder="Buscar alumno..."
                   @bind="_busquedaBenef" @bind:event="oninput"/>
            <select class="filter-select-sm" @bind="_filtroBenef">
                <option value="">Todos</option>
                <option value="activo">Con desayuno gratuito</option>
                <option value="sin">Sin desayuno gratuito</option>
            </select>
        </div>
    </div>

    @if (_cargandoBenef)
    {
        <p style="color:var(--muted)">Cargando alumnos...</p>
    }
    else if (!AlumnosFiltrados.Any())
    {
        <div class="empty-state"><p>No hay alumnos que coincidan con el filtro.</p></div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Instituto</th>
                        <th>Turno</th>
                        <th style="text-align:center">Desayuno gratuito</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in AlumnosFiltrados)
                    {
                        <tr>
                            <td>
                                <div class="user-name">@u.NombreCompleto</div>
                                <div class="user-email">@u.Email</div>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(u.InstitutoNombre))
                                {
                                    <span class="instituto-badge">@u.InstitutoNombre</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td>
                                @if (u.Turno.HasValue)
                                {
                                    <span>@GetTurnoEmoji(u.Turno) @u.Turno</span>
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td style="text-align:center">
                                <button class="btn-icon @(u.DesayunoGratuito ? "btn-icon--success" : "")"
                                        style="font-size:20px;padding:4px 10px"
                                        title="@(u.DesayunoGratuito ? "Clic para desactivar" : "Clic para activar")"
                                        @onclick="() => ToggleDesayuno(u)">
                                    🍊
                                </button>
                                <div style="font-size:11px;color:var(--muted);margin-top:2px">
                                    @(u.DesayunoGratuito ? "Activo" : "Inactivo")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     SECCIÓN 2 — Consumos del día
════════════════════════════════════════════════════════════════════════════ -->
<div class="section-header" style="margin-bottom:12px">
    <h2>Consumos del día</h2>
    <div style="display:flex;align-items:center;gap:8px">
        <label style="color:var(--muted);font-size:13px">Fecha:</label>
        <input type="date" class="form-input" style="width:auto;max-width:180px"
               @bind="_fecha" @bind:format="yyyy-MM-dd"/>
        <button class="btn-primary" @onclick="CargarConsumos">Ver</button>
    </div>
</div>

@if (_cargandoConsumos)
{
    <p style="color:var(--muted)">Cargando consumos...</p>
}
else if (_datos is not null)
{
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin-bottom:24px">
        <div class="stat-card" style="min-width:160px">
            <div class="stat-value">@_totalBeneficiarios</div>
            <div class="stat-label">Beneficiarios activos</div>
        </div>
        <div class="stat-card" style="min-width:160px">
            <div class="stat-value">@_consumos.Count</div>
            <div class="stat-label">Usaron el desayuno</div>
        </div>
        <div class="stat-card" style="min-width:160px">
            <div class="stat-value">@_consumos.Count(c => c.ZumoConsumido)</div>
            <div class="stat-label">Zumos servidos</div>
        </div>
        <div class="stat-card" style="min-width:160px">
            <div class="stat-value">@_consumos.Count(c => c.BocataConsumido)</div>
            <div class="stat-label">Bocatas servidos</div>
        </div>
    </div>

    @if (_consumos.Count == 0)
    {
        <div class="empty-state">
            <p>No hay consumos registrados para esta fecha.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Alumno</th>
                        <th>Instituto</th>
                        <th>Zumo</th>
                        <th>Bocata</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _consumos.OrderBy(c => c.Nombre))
                    {
                        <tr>
                            <td>
                                <div class="user-name">@c.Nombre</div>
                                <div class="user-email">@c.Email</div>
                            </td>
                            <td>@c.Instituto</td>
                            <td>
                                <span class="status-pill @(c.ZumoConsumido ? "pill--on" : "pill--off")">
                                    @(c.ZumoConsumido ? "Consumido" : "No")
                                </span>
                            </td>
                            <td>
                                <span class="status-pill @(c.BocataConsumido ? "pill--on" : "pill--off")">
                                    @(c.BocataConsumido ? "Consumido" : "No")
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // ── Beneficiarios ──────────────────────────────────────────────────────────
    private List<UsuarioDto> _alumnos    = new();
    private bool             _cargandoBenef;
    private string           _busquedaBenef = string.Empty;
    private string           _filtroBenef   = string.Empty;

    private IEnumerable<UsuarioDto> AlumnosFiltrados =>
        _alumnos
            .Where(u => string.IsNullOrEmpty(_busquedaBenef) ||
                        u.NombreCompleto.Contains(_busquedaBenef, StringComparison.OrdinalIgnoreCase) ||
                        u.Email.Contains(_busquedaBenef, StringComparison.OrdinalIgnoreCase))
            .Where(u => _filtroBenef switch
            {
                "activo" => u.DesayunoGratuito,
                "sin"    => !u.DesayunoGratuito,
                _        => true
            });

    private async Task CargarAlumnos()
    {
        _cargandoBenef = true;
        var todos = await Api.GetTodosUsuariosAsync();
        _alumnos = todos.Where(u => u.Rol == RolUsuario.Alumno && u.Estado == EstadoCuenta.Activa).ToList();
        _cargandoBenef = false;
    }

    private async Task ToggleDesayuno(UsuarioDto u)
    {
        await Api.SetDesayunoGratuitoAsync(u.Id, !u.DesayunoGratuito);
        await CargarAlumnos();
    }

    // ── Consumos ───────────────────────────────────────────────────────────────
    private DateOnly      _fecha = DateOnly.FromDateTime(DateTime.Today);
    private bool          _cargandoConsumos;
    private JsonElement?  _datos;
    private int           _totalBeneficiarios;
    private List<ConsumoRow> _consumos = new();

    private async Task CargarConsumos()
    {
        _cargandoConsumos = true;
        _datos   = null;
        _consumos.Clear();

        var raw = await Api.GetConsumosDesayunoAsync(_fecha);
        if (raw is JsonElement je)
        {
            _datos = je;
            _totalBeneficiarios = je.GetProperty("totalBeneficiarios").GetInt32();
            foreach (var item in je.GetProperty("consumos").EnumerateArray())
            {
                _consumos.Add(new ConsumoRow
                {
                    Nombre          = item.GetProperty("nombre").GetString() ?? "",
                    Email           = item.GetProperty("email").GetString() ?? "",
                    Instituto       = item.GetProperty("instituto").GetString() ?? "—",
                    ZumoConsumido   = item.GetProperty("zumoConsumido").GetBoolean(),
                    BocataConsumido = item.GetProperty("bocataConsumido").GetBoolean()
                });
            }
        }
        _cargandoConsumos = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(CargarAlumnos(), CargarConsumos());
    }

    private static string GetTurnoEmoji(Turno? t) => t switch
    {
        Turno.Manana => "🌅",
        Turno.Tarde  => "🌤️",
        Turno.Noche  => "🌙",
        _            => ""
    };

    private record ConsumoRow
    {
        public string Nombre          { get; init; } = "";
        public string Email           { get; init; } = "";
        public string Instituto       { get; init; } = "";
        public bool   ZumoConsumido   { get; init; }
        public bool   BocataConsumido { get; init; }
    }
}
