@page "/login"
@layout CafeIES.Admin.Layout.EmptyLayout
@inject AuthAdminService Auth
@inject NavigationManager Nav

<div class="login-page">
    <div class="login-box">

        <div class="login-logo">Café<span class="accent">IES</span></div>
        <div class="login-sub">Panel de administración</div>

        <div class="form-group">
            <label class="form-label">Email</label>
            <input class="form-control" type="email"
                   @bind="email" placeholder="admin@cafeies.local"/>
        </div>

        <div class="form-group">
            <label class="form-label">Contraseña</label>
            <input class="form-control" type="password"
                   @bind="password" @onkeydown="OnKeyDown" placeholder="••••••••"/>
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div style="color:var(--red); font-size:13px; margin-bottom:16px;">
                ⚠️ @error
            </div>
        }

        <button class="btn btn-primary btn-lg" style="width:100%"
                @onclick="HacerLogin" disabled="@loading">
            @(loading ? "Entrando..." : "Entrar →")
        </button>

    </div>
</div>

@code {
    private string email    = "";
    private string password = "";
    private string error    = "";
    private bool   loading  = false;

    protected override void OnInitialized()
    {
        if (Auth.EstaAutenticado) Nav.NavigateTo("/");
    }

    private async Task HacerLogin()
    {
        loading = true;
        error   = "";
        StateHasChanged();

        var ok = await Auth.LoginAsync(email, password);
        loading = false;

        if (ok) Nav.NavigateTo("/");
        else    error = "Credenciales incorrectas o sin permisos de admin.";
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await HacerLogin();
    }
}
