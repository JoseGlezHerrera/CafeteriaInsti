@page "/institutos"
@inject AdminApiService Api

<PageTitle>Institutos - CafeIES Admin</PageTitle>

<div class="page-header">
    <h1>Institutos</h1>
    <button class="btn-primary" @onclick="AbrirNuevo">+ Nuevo instituto</button>
</div>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Codigo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in _institutos)
            {
                <tr>
                    <td>@i.Id</td>
                    <td>@i.Nombre</td>
                    <td><code>@i.CodigoCorto</code></td>
                    <td>
                        <span class="status-pill @(EsActivo(i.Id) ? "pill--on" : "pill--off")">
                            @(EsActivo(i.Id) ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        <button class="btn-icon" title="Editar" @onclick="() => AbrirEditar(i)">&#9998;</button>
                        <button class="btn-icon" title="@(EsActivo(i.Id) ? "Desactivar" : "Activar")"
                                @onclick="() => ToggleActivo(i.Id)">
                            @(EsActivo(i.Id) ? "&#128274;" : "&#9989;")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_mostrarModal)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editandoId.HasValue ? "Editar instituto" : "Nuevo instituto")</h3>
                <button class="modal-close" @onclick="CerrarModal">&#10005;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Nombre</label>
                    <input class="form-input" @bind="_nombre" placeholder="IES Ejemplo" />
                </div>
                <div class="form-group">
                    <label>Codigo corto</label>
                    <input class="form-input" @bind="_codigo" placeholder="IES-EJ" />
                </div>
                <div class="form-group">
                    <label>Direccion</label>
                    <input class="form-input" @bind="_direccion" placeholder="Calle Ejemplo 1" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p style="color:var(--red);font-size:13px;margin-top:8px">@_error</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button class="btn-primary" @onclick="Guardar">Guardar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<InstitutoDto> _institutos = new();
    private HashSet<int> _inactivos = new();
    private bool _mostrarModal;
    private int? _editandoId;
    private string _nombre = string.Empty;
    private string _codigo = string.Empty;
    private string _direccion = string.Empty;
    private string _error = string.Empty;

    protected override async Task OnInitializedAsync()
        => await Recargar();

    private async Task Recargar()
        => _institutos = await Api.GetInstitutosAsync();

    private bool EsActivo(int id) => !_inactivos.Contains(id);

    private void AbrirNuevo()
    {
        _editandoId = null;
        _nombre = string.Empty;
        _codigo = string.Empty;
        _direccion = string.Empty;
        _error = string.Empty;
        _mostrarModal = true;
    }

    private void AbrirEditar(InstitutoDto i)
    {
        _editandoId = i.Id;
        _nombre = i.Nombre;
        _codigo = i.CodigoCorto;
        _direccion = string.Empty;
        _error = string.Empty;
        _mostrarModal = true;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_codigo))
        {
            _error = "El nombre y el codigo son obligatorios.";
            return;
        }

        var req = new CrearInstitutoRequest(_nombre.Trim(), _codigo.Trim(), _direccion.Trim());
        bool ok;
        if (_editandoId.HasValue)
            ok = await Api.ActualizarInstitutoAsync(_editandoId.Value, req);
        else
            ok = await Api.CrearInstitutoAsync(req);

        if (!ok)
        {
            _error = "Error al guardar. Verifica que el codigo corto no este duplicado.";
            return;
        }

        _mostrarModal = false;
        await Recargar();
    }

    private async Task ToggleActivo(int id)
    {
        var ok = await Api.ToggleInstitutoAsync(id);
        if (ok)
        {
            if (_inactivos.Contains(id))
                _inactivos.Remove(id);
            else
                _inactivos.Add(id);
        }
        await Recargar();
    }

    private void CerrarModal() => _mostrarModal = false;
}
