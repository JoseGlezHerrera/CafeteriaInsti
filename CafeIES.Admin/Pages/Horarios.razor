@page "/horarios"
@inject AdminApiService Api

<PageTitle>Horarios · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Franjas horarias</h1>
    <p class="page-sub">Configura cuándo puede pedir cada turno. Los cambios son inmediatos.</p>
</div>

@foreach (var turno in new[] { Turno.Manana, Turno.Tarde, Turno.Noche })
{
    var franjasTurno = _franjas.Where(f => f.Turno == turno).OrderBy(f => f.HoraInicio).ToList();
    <div class="turno-section">
        <div class="turno-header">
            <span class="turno-emoji">@GetTurnoEmoji(turno)</span>
            <h2>Turno @turno</h2>
            <button class="btn-sm" @onclick="() => AbrirNuevaFranja(turno)">+ Añadir franja</button>
        </div>
        @if (!franjasTurno.Any())
        {
            <div class="empty-mini">Sin franjas bloqueadas — los alumnos de este turno pueden pedir en cualquier momento.</div>
        }
        else
        {
            <div class="franjas-list">
                @foreach (var f in franjasTurno)
                {
                    var activa = EsFranjaActiva(f);
                    <div class="franja-card @(!f.Activa ? "franja-card--off" : "") @(activa ? "franja-card--live" : "")">
                        @if (activa)
                        {
                            <span class="live-dot">●</span>
                        }
                        <div class="franja-desc">@f.Descripcion</div>
                        <div class="franja-horario">@f.HoraInicio — @f.HoraFin</div>
                        <span class="status-pill @(f.EsBloqueada ? "pill--block" : "pill--allow") franja-status" title="@(f.EsBloqueada ? "Bloquea pedidos" : "Permite pedidos")">
                            @(f.EsBloqueada ? "🚫 Bloquea" : "✅ Permite")
                        </span>
                        <span class="status-pill @(f.Activa ? "pill--on" : "pill--off") franja-status">
                            @(f.Activa ? "Activa" : "Desactivada")
                        </span>
                        <button class="btn-icon btn-icon--danger franja-del"
                                @onclick="() => ConfirmarEliminarFranja(f.Id, f.Descripcion)">
                            🗑
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@if (_mostrarModal)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Nueva franja · @GetTurnoEmoji(_turnoModal) Turno @_turnoModal</h3>
                <button class="modal-close" @onclick="CerrarModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Descripción</label>
                    <input class="form-input" @bind="_fDesc" placeholder="ej. Recreo" />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Hora inicio (HH:mm)</label>
                        <input class="form-input" type="text" placeholder="08:00" @bind="_fInicio" />
                    </div>
                    <div class="form-group">
                        <label>Hora fin (HH:mm)</label>
                        <input class="form-input" type="text" placeholder="09:00" @bind="_fFin" />
                    </div>
                </div>
                <div class="form-group" style="margin-top:12px">
                    <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                        <input type="checkbox" @bind="_fEsBloqueada" />
                        <span>🚫 Bloquear pedidos durante esta franja (ej. horario de clase)</span>
                    </label>
                    <p style="font-size:12px;color:var(--muted);margin-top:4px;margin-left:24px">
                        Si está marcado, los alumnos <strong>no podrán</strong> hacer pedidos en este horario.
                    </p>
                </div>
                @if (!string.IsNullOrEmpty(_fError))
                {
                    <p style="color:var(--red);font-size:13px;margin-top:8px">⚠️ @_fError</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CerrarModal" disabled="@_guardando">Cancelar</button>
                <button class="btn-primary" @onclick="GuardarFranja" disabled="@_guardando">
                    @(_guardando ? "Guardando…" : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@if (_confirmarEliminar)
{
    <div class="modal-overlay" @onclick="CancelarEliminarFranja">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:420px">
            <div class="modal-header">
                <h3>Eliminar franja</h3>
                <button class="modal-close" @onclick="CancelarEliminarFranja">✕</button>
            </div>
            <div class="modal-body">
                <p>¿Eliminar la franja <strong>@_eliminarDesc</strong>? Los alumnos de este turno podrían perder acceso a pedidos.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CancelarEliminarFranja" disabled="@_guardando">Cancelar</button>
                <button class="btn-primary" style="background:var(--red)" @onclick="EliminarFranjaConfirmada" disabled="@_guardando">
                    @(_guardando ? "Eliminando…" : "Eliminar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<FranjaHorariaDto> _franjas = new();
    private bool _mostrarModal;
    private Turno _turnoModal;
    private string _fDesc = string.Empty;
    private string _fInicio = "08:00";
    private string _fFin = "09:00";
    private string _fError = string.Empty;
    private bool   _fEsBloqueada;

    private bool   _guardando;         // UX-011: bloquea botones durante operación en curso
    private bool   _confirmarEliminar;
    private int    _eliminarId;
    private string _eliminarDesc = string.Empty;

    protected override async Task OnInitializedAsync()
        => _franjas = await Api.GetHorariosAsync();

    private void AbrirNuevaFranja(Turno turno)
    {
        _turnoModal = turno; _fDesc = string.Empty;
        _fInicio = "08:00"; _fFin = "09:00";
        _fError = string.Empty;
        _fEsBloqueada = false;
        _mostrarModal = true;
    }

    private async Task GuardarFranja()
    {
        if (string.IsNullOrWhiteSpace(_fDesc)) { _fError = "La descripción es obligatoria."; return; }
        if (!TimeOnly.TryParse(_fInicio, out _) || !TimeOnly.TryParse(_fFin, out _))
        {
            _fError = "Formato de hora inválido. Usa HH:mm (ej. 08:00).";
            return;
        }
        if (_fInicio == _fFin)
        {
            _fError = "La hora de inicio y fin no pueden ser iguales.";
            return;
        }
        _fError    = string.Empty;
        _guardando = true;
        await Api.CrearFranjaAsync(new UpsertFranjaRequest(_turnoModal, _fDesc, _fInicio, _fFin, true, _fEsBloqueada));
        _franjas      = await Api.GetHorariosAsync();
        _guardando    = false;
        _mostrarModal = false;
    }

    private void ConfirmarEliminarFranja(int id, string desc)
    {
        _eliminarId   = id;
        _eliminarDesc = desc;
        _confirmarEliminar = true;
    }

    private void CancelarEliminarFranja()
    {
        _confirmarEliminar = false;
        _eliminarId   = 0;
        _eliminarDesc = string.Empty;
    }

    private async Task EliminarFranjaConfirmada()
    {
        _confirmarEliminar = false;
        _guardando         = true;
        await Api.EliminarFranjaAsync(_eliminarId);
        _franjas      = await Api.GetHorariosAsync();
        _guardando    = false;
        _eliminarId   = 0;
        _eliminarDesc = string.Empty;
    }

    private void CerrarModal() => _mostrarModal = false;

    // FIX-21: Lógica alineada con FranjaHoraria.EstaActiva (Entities.cs).
    // Se mantiene aquí porque FranjaHorariaDto no tiene la propiedad calculada.
    private static bool EsFranjaActiva(FranjaHorariaDto f)
    {
        if (!f.Activa) return false;
        try
        {
            var spainTz = TimeZoneInfo.FindSystemTimeZoneById(
                OperatingSystem.IsWindows() ? "Romance Standard Time" : "Europe/Madrid");
            var ahora = TimeOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, spainTz));
            var inicio = TimeOnly.Parse(f.HoraInicio);
            var fin    = TimeOnly.Parse(f.HoraFin);
            if (inicio > fin) // franja que cruza medianoche
                return ahora >= inicio || ahora <= fin;
            return ahora >= inicio && ahora <= fin;
        }
        catch { return false; }
    }

    private static string GetTurnoEmoji(Turno t) => t switch
    {
        Turno.Manana => "🌅",
        Turno.Tarde => "🌤️",
        Turno.Noche => "🌙",
        _ => ""
    };
}