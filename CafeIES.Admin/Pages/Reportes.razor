@page "/reportes"
@inject AdminApiService Api

<PageTitle>Reportes · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Reportes</h1>
    <p class="page-sub">Resumen de actividad del período seleccionado.</p>
</div>

<div class="filters-bar">
    <input class="search-input" type="date" @bind="_desde" title="Desde"/>
    <input class="search-input" type="date" @bind="_hasta" title="Hasta"/>
    <button class="btn-primary" @onclick="Cargar">Generar</button>
</div>

@if (_cargando)
{
    <div class="loading-wrap"><div class="spinner"></div><p>Calculando...</p></div>
}
else if (_pedidos.Any())
{
    var completados = _pedidos.Where(p => p.Estado != EstadoPedido.Cancelado).ToList();

    <!-- Resumen en cards -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">PEDIDOS TOTALES</div>
            <div class="stat-value">@_pedidos.Count</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">COMPLETADOS</div>
            <div class="stat-value">@completados.Count</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">CANCELADOS</div>
            <div class="stat-value">@_pedidos.Count(p => p.Estado == EstadoPedido.Cancelado)</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">INGRESOS</div>
            <div class="stat-value">@completados.Sum(p => p.Total).ToString("F2")€</div>
        </div>
    </div>

    <!-- Ranking de productos -->
    <div class="section">
        <div class="section-header"><h2>🏆 Productos más vendidos</h2></div>
        <div class="table-card">
            <table class="data-table">
                <thead>
                    <tr><th>Producto</th><th>Unidades</th><th>Ingresos</th></tr>
                </thead>
                <tbody>
                    @foreach (var item in ProductosRanking)
                    {
                        <tr>
                            <td><strong>@item.Nombre</strong></td>
                            <td>@item.Unidades</td>
                            <td class="price-cell">@item.Ingresos.ToString("F2")€</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Métodos de pago -->
    <div class="section">
        <div class="section-header"><h2>💳 Métodos de pago</h2></div>
        <div class="stats-grid">
            @foreach (var grupo in completados.GroupBy(p => p.MetodoPago).OrderByDescending(g => g.Count()))
            {
                <div class="stat-card">
                    <div class="stat-label">@GetPagoTexto(grupo.Key)</div>
                    <div class="stat-value">@grupo.Count()</div>
                    <div class="stat-warning">@grupo.Sum(p => p.Total).ToString("F2")€</div>
                </div>
            }
        </div>
    </div>
}
else if (_generado)
{
    <div class="empty-state">
        <span class="empty-icon">📊</span>
        <p>Sin datos para el período seleccionado</p>
    </div>
}

@code {
    private List<PedidoDto> _pedidos  = new();
    private bool _cargando  = false;
    private bool _generado  = false;
    private DateTime? _desde = DateTime.Today.AddDays(-7);
    private DateTime? _hasta = DateTime.Today;

    private IEnumerable<(string Nombre, int Unidades, decimal Ingresos)> ProductosRanking =>
        _pedidos
            .Where(p => p.Estado != EstadoPedido.Cancelado)
            .SelectMany(p => p.Lineas)
            .GroupBy(l => l.ProductoNombre)
            .Select(g => (g.Key, g.Sum(l => l.Cantidad), g.Sum(l => l.Subtotal)))
            .OrderByDescending(x => x.Item2);

    private async Task Cargar()
    {
        _cargando = true;
        _pedidos  = await Api.GetPedidosAsync(_desde, _hasta);
        _cargando = false;
        _generado = true;
    }

    private static string GetPagoTexto(MetodoPago m) => m switch
    {
        MetodoPago.Tarjeta   => "💳 Tarjeta",
        MetodoPago.GooglePay => "Google Pay",
        MetodoPago.ApplePay  => "Apple Pay",
        _                    => m.ToString()
    };
}
