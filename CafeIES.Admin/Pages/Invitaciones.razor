@page "/invitaciones"
@inject AdminApiService Api
@inject IJSRuntime JS

<PageTitle>Invitaciones · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Invitaciones</h1>
    <p class="page-sub">Genera QR o enlaces para que profesores y personal se registren con el rol correcto.</p>
</div>

@if (_cargando)
{
    <div class="loading-wrap"><div class="spinner"></div><p>Cargando...</p></div>
}

@if (!string.IsNullOrEmpty(_errorGen))
{
    <div class="alert alert-danger" style="margin-bottom:12px">⚠️ @_errorGen</div>
}

<div class="invite-grid">

    <!-- Card Profesores -->
    <div class="invite-card @(_invProfesor?.EsValida == true ? "invite-card--active" : "")">
        <div class="invite-card-header">
            <div>
                <div class="invite-role">👨‍🏫 Profesores</div>
                <div class="invite-desc">Acceso sin restricción horaria</div>
            </div>
            <span class="status-pill @(_invProfesor?.EsValida == true ? "pill--on" : "pill--off")">
                @(_invProfesor?.EsValida == true ? "Activo" : "Inactivo")
            </span>
        </div>

        @if (_invProfesor?.EsValida == true)
        {
            <div class="qr-wrap">
                <img src="@Api.GetQrUrl(_invProfesor.Id)" class="qr-img" alt="QR Profesores"/>
            </div>
            <div class="invite-url" title="Codigo de invitacion">Codigo: <strong>@_invProfesor.Token</strong></div>
            <div class="invite-meta">
                Caduca: @_invProfesor.FechaExpiracion.ToString("dd/MM/yyyy") ·
                Usos: @_invProfesor.UsosActuales@(_invProfesor.UsosMaximos.HasValue ? $"/{_invProfesor.UsosMaximos}" : "")
            </div>
            <div class="invite-actions">
                <button class="btn-secondary" @onclick="() => CopiarUrl(_invProfesor.Token)">
                    📋 Copiar codigo
                </button>
                <button class="btn-icon btn-icon--danger"
                        @onclick="() => ConfirmarRevocar(_invProfesor.Id)">
                    🗑 Revocar
                </button>
            </div>
        }
        else
        {
            <div class="invite-empty">
                <span class="invite-lock">🔒</span>
                <p>Sin enlace activo</p>
            </div>
            <button class="btn-primary btn-full"
                    @onclick="() => GenerarInvitacion(TipoInvitacion.Profesor)">
                ✨ Generar QR
            </button>
        }
    </div>

    <!-- Card Empleados de cafetería -->
    <div class="invite-card @(_invEmpleado?.EsValida == true ? "invite-card--active" : "")">
        <div class="invite-card-header">
            <div>
                <div class="invite-role">☕ Empleados de cafetería</div>
                <div class="invite-desc">Gestión de pedidos y productos</div>
            </div>
            <span class="status-pill @(_invEmpleado?.EsValida == true ? "pill--on" : "pill--off")">
                @(_invEmpleado?.EsValida == true ? "Activo" : "Inactivo")
            </span>
        </div>

        @if (_invEmpleado?.EsValida == true)
        {
            <div class="qr-wrap">
                <img src="@Api.GetQrUrl(_invEmpleado.Id)" class="qr-img" alt="QR Empleados"/>
            </div>
            <div class="invite-url" title="Codigo de invitacion">Codigo: <strong>@_invEmpleado.Token</strong></div>
            <div class="invite-meta">
                Caduca: @_invEmpleado.FechaExpiracion.ToString("dd/MM/yyyy") ·
                Usos: @_invEmpleado.UsosActuales@(_invEmpleado.UsosMaximos.HasValue ? $"/{_invEmpleado.UsosMaximos}" : "")
            </div>
            <div class="invite-actions">
                <button class="btn-secondary" @onclick="() => CopiarUrl(_invEmpleado.Token)">
                    📋 Copiar codigo
                </button>
                <button class="btn-icon btn-icon--danger"
                        @onclick="() => ConfirmarRevocar(_invEmpleado.Id)">
                    🗑 Revocar
                </button>
            </div>
        }
        else
        {
            <div class="invite-empty">
                <span class="invite-lock">🔒</span>
                <p>Sin enlace activo</p>
            </div>
            <button class="btn-primary btn-full"
                    @onclick="() => GenerarInvitacion(TipoInvitacion.Empleado)">
                ✨ Generar QR
            </button>
        }
    </div>

    <!-- Card Personal -->
    <div class="invite-card @(_invPersonal?.EsValida == true ? "invite-card--active" : "")">
        <div class="invite-card-header">
            <div>
                <div class="invite-role">🏢 Personal</div>
                <div class="invite-desc">Acceso sin restricción horaria</div>
            </div>
            <span class="status-pill @(_invPersonal?.EsValida == true ? "pill--on" : "pill--off")">
                @(_invPersonal?.EsValida == true ? "Activo" : "Inactivo")
            </span>
        </div>

        @if (_invPersonal?.EsValida == true)
        {
            <div class="qr-wrap">
                <img src="@Api.GetQrUrl(_invPersonal.Id)" class="qr-img" alt="QR Personal"/>
            </div>
            <div class="invite-url" title="Codigo de invitacion">Codigo: <strong>@_invPersonal.Token</strong></div>
            <div class="invite-meta">
                Caduca: @_invPersonal.FechaExpiracion.ToString("dd/MM/yyyy") ·
                Usos: @_invPersonal.UsosActuales@(_invPersonal.UsosMaximos.HasValue ? $"/{_invPersonal.UsosMaximos}" : "")
            </div>
            <div class="invite-actions">
                <button class="btn-secondary" @onclick="() => CopiarUrl(_invPersonal.Token)">
                    📋 Copiar codigo
                </button>
                <button class="btn-icon btn-icon--danger"
                        @onclick="() => ConfirmarRevocar(_invPersonal.Id)">
                    🗑 Revocar
                </button>
            </div>
        }
        else
        {
            <div class="invite-empty">
                <span class="invite-lock">🔒</span>
                <p>Sin enlace activo</p>
            </div>
            <button class="btn-primary btn-full"
                    @onclick="() => GenerarInvitacion(TipoInvitacion.Personal)">
                ✨ Generar QR
            </button>
        }
    </div>

</div>

<!-- Confirmar revocación -->
@if (_confirmarRevocar)
{
    <div class="modal-overlay" @onclick="CancelarRevocar">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:420px">
            <div class="modal-header">
                <h3>Revocar invitación</h3>
                <button class="modal-close" @onclick="CancelarRevocar">✕</button>
            </div>
            <div class="modal-body">
                <p>¿Revocar esta invitación? Los enlaces y QR existentes dejarán de funcionar.</p>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CancelarRevocar">Cancelar</button>
                <button class="btn-primary" style="background:var(--red)" @onclick="RevocarConfirmada">Revocar</button>
            </div>
        </div>
    </div>
}

<!-- Opciones de generación -->
@if (_mostrarOpcionesGen)
{
    <div class="modal-overlay" @onclick="() => _mostrarOpcionesGen = false">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Generar invitación · @_tipoGenerando</h3>
                <button class="modal-close" @onclick="() => _mostrarOpcionesGen = false">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Validez (días)</label>
                    <input class="form-input" type="number" min="1" max="365" @bind="_diasValidez"/>
                </div>
                <div class="form-group">
                    <label>Máximo de usos (vacío = ilimitado)</label>
                    <input class="form-input" type="number" min="1" @bind="_usosMaximos" placeholder="Ilimitado"/>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="() => _mostrarOpcionesGen = false">Cancelar</button>
                <button class="btn-primary" @onclick="ConfirmarGeneracion">Generar</button>
            </div>
        </div>
    </div>
}

@code {
    private List<InvitacionDto> _invitaciones = new();
    private InvitacionDto?     _invProfesor;
    private InvitacionDto?     _invPersonal;
    private InvitacionDto?     _invEmpleado;
    private bool               _mostrarOpcionesGen;
    private TipoInvitacion     _tipoGenerando;
    private int                _diasValidez  = 7;
    private int?               _usosMaximos;
    private bool               _cargando   = true;   // UX-015: spinner inicial
    private bool               _generando  = false;  // BUG-019: evita doble-clic al generar
    private string             _errorGen   = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Recargar();
        _cargando = false;
    }

    private async Task Recargar()
    {
        _invitaciones = await Api.GetInvitacionesAsync();
        _invProfesor  = _invitaciones.FirstOrDefault(i => i.Tipo == TipoInvitacion.Profesor && i.EsValida);
        _invPersonal  = _invitaciones.FirstOrDefault(i => i.Tipo == TipoInvitacion.Personal && i.EsValida);
        _invEmpleado  = _invitaciones.FirstOrDefault(i => i.Tipo == TipoInvitacion.Empleado && i.EsValida);
    }

    private void GenerarInvitacion(TipoInvitacion tipo)
    {
        _tipoGenerando      = tipo;
        _diasValidez        = 7;
        _usosMaximos        = null;
        _errorGen           = string.Empty;
        _mostrarOpcionesGen = true;
    }

    private async Task ConfirmarGeneracion()
    {
        if (_generando) return;  // BUG-019: guard contra doble-clic
        _generando          = true;
        _mostrarOpcionesGen = false;
        var result = await Api.CrearInvitacionAsync(new CrearInvitacionRequest(
            _tipoGenerando, _usosMaximos, _diasValidez));
        if (result is null) _errorGen = "Error al generar la invitación. Inténtalo de nuevo.";
        _generando = false;
        await Recargar();
    }

    private async Task RevocarInvitacion(int id)
    {
        await Api.RevocarInvitacionAsync(id);
        await Recargar();
    }

    private bool _confirmarRevocar;
    private int  _revocarId;

    private void ConfirmarRevocar(int id)
    {
        _revocarId = id;
        _confirmarRevocar = true;
    }

    private void CancelarRevocar()
    {
        _confirmarRevocar = false;
        _revocarId = 0;
    }

    private async Task RevocarConfirmada()
    {
        _confirmarRevocar = false;
        await RevocarInvitacion(_revocarId);
        _revocarId = 0;
    }

    private async Task CopiarUrl(string url)
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", url); }
        catch { }
    }
}
