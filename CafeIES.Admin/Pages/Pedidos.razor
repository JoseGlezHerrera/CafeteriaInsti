@page "/pedidos"
@inject AdminApiService Api
@inject IJSRuntime JS

<PageTitle>Pedidos · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Pedidos</h1>
    <button class="btn-secondary" @onclick="Recargar">🔄 Actualizar</button>
</div>

<!-- Filtros -->
<div class="filters-bar">
    <select class="filter-select" @bind="_estadoFiltro">
        <option value="">Todos los estados</option>
        <option value="Pendiente">⏳ Pendiente</option>
        <option value="EnPreparacion">🔧 En preparación</option>
        <option value="Listo">✅ Listo</option>
        <option value="Entregado">📦 Entregado</option>
        <option value="Cancelado">❌ Cancelado</option>
    </select>
    <input class="search-input" type="date" @bind="_desde" title="Desde"/>
    <input class="search-input" type="date" @bind="_hasta" title="Hasta"/>
    <button class="btn-primary" @onclick="Recargar">Filtrar</button>
</div>

@if (_cargando)
{
    <div class="loading-wrap"><div class="spinner"></div><p>Cargando...</p></div>
}
else if (!PedidosFiltrados.Any())
{
    <div class="empty-state">
        <span class="empty-icon">🧾</span>
        <p>No hay pedidos con estos filtros</p>
    </div>
}
else
{
    <div class="table-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Usuario</th>
                    <th>Hora</th>
                    <th>Productos</th>
                    <th>Total</th>
                    <th>Pago</th>
                    <th>Estado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in PedidosFiltrados)
                {
                    <tr>
                        <td><strong>#@p.NumeroPedido.ToString("D3")</strong></td>
                        <td>
                            <div class="user-cell">
                                <div>
                                    <div class="user-name">@p.UsuarioNombre</div>
                                    <div class="user-email">@p.UsuarioEmail</div>
                                </div>
                            </div>
                        </td>
                        <td>@p.FechaCreacion.ToString("dd/MM HH:mm")</td>
                        <td>
                            <div class="order-items-cell">
                                @string.Join(", ", p.Lineas.Select(l => $"{l.ProductoNombre} ×{l.Cantidad}"))
                                @if (!string.IsNullOrWhiteSpace(p.Notas))
                                {
                                    <div class="order-nota">📝 @p.Notas</div>
                                }
                            </div>
                        </td>
                        <td class="price-cell"><strong>@p.Total.ToString("F2")€</strong></td>
                        <td>@GetPagoTexto(p.MetodoPago)</td>
                        <td>
                            <span class="status-pill @GetEstadoClass(p.Estado)">
                                @GetEstadoTexto(p.Estado)
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                @if (p.Estado == EstadoPedido.Pendiente)
                                {
                                    <button class="btn-sm btn-prep"
                                            @onclick="() => CambiarEstado(p.Id, EstadoPedido.EnPreparacion)">
                                        🔧 Preparar
                                    </button>
                                }
                                else if (p.Estado == EstadoPedido.EnPreparacion)
                                {
                                    <button class="btn-sm btn-ready"
                                            @onclick="() => CambiarEstado(p.Id, EstadoPedido.Listo)">
                                        ✅ Listo
                                    </button>
                                }
                                else if (p.Estado == EstadoPedido.Listo)
                                {
                                    <button class="btn-sm"
                                            @onclick="() => CambiarEstado(p.Id, EstadoPedido.Entregado)">
                                        📦 Entregado
                                    </button>
                                }
                                @if (p.Estado == EstadoPedido.Pendiente || p.Estado == EstadoPedido.EnPreparacion)
                                {
                                    <button class="btn-icon btn-icon--danger" title="Cancelar"
                                            @onclick="() => ConfirmarCancelar(p.Id)">🗑</button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="table-footer">
        <span>@PedidosFiltrados.Count() pedidos · Total: @PedidosFiltrados.Sum(p => p.Estado != EstadoPedido.Cancelado ? p.Total : 0).ToString("F2")€</span>
    </div>
}

@code {
    private List<PedidoDto> _pedidos    = new();
    private bool            _cargando   = true;
    private string          _estadoFiltro = string.Empty;
    private DateTime?       _desde;
    private DateTime?       _hasta;

    private IEnumerable<PedidoDto> PedidosFiltrados =>
        _pedidos.Where(p => string.IsNullOrEmpty(_estadoFiltro) || p.Estado.ToString() == _estadoFiltro);

    protected override async Task OnInitializedAsync() => await Recargar();

    private async Task Recargar()
    {
        _cargando = true;
        _pedidos  = await Api.GetPedidosAsync(_desde, _hasta);
        _cargando = false;
    }

    private async Task CambiarEstado(int id, EstadoPedido nuevoEstado)
    {
        await Api.CambiarEstadoPedidoAsync(id, nuevoEstado);
        await Recargar();
    }

    private async Task ConfirmarCancelar(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Cancelar este pedido? Se restaurará el stock."))
            return;
        await CambiarEstado(id, EstadoPedido.Cancelado);
    }

    private static string GetEstadoTexto(EstadoPedido e) => e switch
    {
        EstadoPedido.Pendiente     => "⏳ Pendiente",
        EstadoPedido.EnPreparacion => "🔧 En preparación",
        EstadoPedido.Listo         => "✅ Listo",
        EstadoPedido.Entregado     => "📦 Entregado",
        EstadoPedido.Cancelado     => "❌ Cancelado",
        _                          => e.ToString()
    };

    private static string GetEstadoClass(EstadoPedido e) => e switch
    {
        EstadoPedido.Pendiente     => "pill--warning",
        EstadoPedido.EnPreparacion => "pill--prep",
        EstadoPedido.Listo         => "pill--on",
        EstadoPedido.Entregado     => "pill--on",
        EstadoPedido.Cancelado     => "pill--off",
        _                          => ""
    };

    private static string GetPagoTexto(MetodoPago m) => m switch
    {
        MetodoPago.Tarjeta   => "💳 Tarjeta",
        MetodoPago.GooglePay => "Google Pay",
        MetodoPago.ApplePay  => "Apple Pay",
        _                    => m.ToString()
    };
}
