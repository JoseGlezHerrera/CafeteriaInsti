@page "/productos"
@inject AdminApiService Api
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Productos · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Productos</h1>
    <button class="btn-primary" @onclick="AbrirNuevoProducto">+ Nuevo producto</button>
</div>

<!-- Filtros -->
<div class="filters-bar">
    <input class="search-input" placeholder="🔍 Buscar producto..." @bind="_busqueda" @bind:event="oninput"/>
    <select class="filter-select" @bind="_categoriaFiltro">
        <option value="">Todas las categorías</option>
        @foreach (var cat in _categorias)
        {
            <option value="@cat.Nombre">@cat.Emoji @cat.Nombre</option>
        }
    </select>
    <label class="filter-check">
        <input type="checkbox" @bind="_mostrarOcultos"/> Mostrar ocultos
    </label>
</div>

<!-- Tabla de productos -->
<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Foto</th>
                <th>Producto</th>
                <th>Categoría</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in ProductosFiltrados)
            {
                <tr class="@(!prod.Activo ? "row--hidden" : "")">
                    <td>
                        @if (!string.IsNullOrEmpty(prod.ImagenUrl))
                        {
                            <img src="@prod.ImagenUrl" alt="@prod.Nombre"
                                 style="width:48px;height:48px;object-fit:cover;border-radius:8px;"/>
                        }
                        else
                        {
                            <span style="font-size:28px;display:block;text-align:center">@prod.CategoriaEmoji</span>
                        }
                    </td>
                    <td>
                        <div class="prod-name-cell">
                            <div>
                                <div class="prod-name">@prod.Nombre</div>
                                <div class="prod-desc">@prod.Descripcion</div>
                            </div>
                        </div>
                    </td>
                    <td><span class="cat-badge">@prod.CategoriaNombre</span></td>
                    <td class="price-cell">@prod.Precio.ToString("F2")€</td>
                    <td>
                        <div class="stock-cell">
                            @if (prod.Stock == -1)
                            {
                                <span class="stock-pill stock--unlimited">∞</span>
                            }
                            else
                            {
                                <div class="stock-bar-wrap">
                                    <div class="stock-bar-bg">
                                        <div class="stock-bar-fill @GetStockClass(prod.Stock)"
                                             style="width: @GetStockPercent(prod.Stock)%"></div>
                                    </div>
                                    <span class="stock-num @(prod.Stock <= 5 ? "stock-num--low" : "")">
                                        @prod.Stock
                                    </span>
                                </div>
                                <input type="number" class="stock-quick-edit"
                                       min="0" value="@prod.Stock"
                                       @onchange="e => ActualizarStock(prod.Id, int.Parse(e.Value!.ToString()!))"
                                       title="Editar stock"/>
                            }
                        </div>
                    </td>
                    <td>
                        <span class="status-pill @(prod.Activo ? "pill--on" : "pill--off")">
                            @(prod.Activo ? "Activo" : "Oculto")
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn-icon" title="Editar"
                                    @onclick="() => AbrirEditar(prod)">✏️</button>
                            <button class="btn-icon" title="@(prod.Activo ? "Ocultar" : "Activar")"
                                    @onclick="() => ToggleActivo(prod.Id)">
                                @(prod.Activo ? "👁" : "🔒")
                            </button>
                            <button class="btn-icon btn-icon--danger" title="Eliminar"
                                    @onclick="() => ConfirmarEliminar(prod.Id)">🗑</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal Nuevo/Editar Producto -->
@if (_mostrarModal)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editandoId.HasValue ? "Editar producto" : "Nuevo producto")</h3>
                <button class="modal-close" @onclick="CerrarModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Nombre</label>
                    <input class="form-input" @bind="_form.Nombre" placeholder="ej. Bocadillo Mixto"/>
                </div>
                <div class="form-group">
                    <label>Descripción</label>
                    <input class="form-input" @bind="_form.Descripcion" placeholder="Breve descripción"/>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Precio (€)</label>
                        <input class="form-input" type="number" step="0.10" min="0"
                               @bind="_form.Precio" @bind:culture="System.Globalization.CultureInfo.InvariantCulture"/>
                    </div>
                    <div class="form-group">
                        <label>Stock (-1 = ilimitado)</label>
                        <input class="form-input" type="number" min="-1"
                               @bind="_form.Stock"/>
                    </div>
                </div>
                <div class="form-group">
                    <label>Categoría</label>
                    @if (_categorias.Count == 0)
                    {
                        <p style="color:var(--accent);font-size:13px;margin-top:4px">⚠️ Crea al menos una categoría antes de añadir productos.</p>
                    }
                    else
                    {
                        <select class="form-input" @bind="_form.CategoriaId">
                            @foreach (var cat in _categorias)
                            {
                                <option value="@cat.Id">@cat.Emoji @cat.Nombre</option>
                            }
                        </select>
                    }
                </div>

                <!-- Desayuno gratuito -->
                <div class="form-group">
                    <label>Desayuno gratuito 🍊</label>
                    <select class="form-input" @bind="_form.ComponenteDesayuno">
                        <option value="@ComponenteDesayuno.Ninguno">No forma parte del desayuno gratuito</option>
                        <option value="@ComponenteDesayuno.Zumo">Zumo (componente zumo)</option>
                        <option value="@ComponenteDesayuno.Bocata">Bocadillo / sándwich (componente bocata)</option>
                    </select>
                    <p style="color:var(--muted);font-size:11px;margin-top:4px">
                        Los beneficiarios pueden obtener 1 zumo + 1 bocata al día gratis.
                    </p>
                </div>

                <!-- Alérgenos -->
                @if (_alergenos.Count > 0)
                {
                    <div class="form-group">
                        <label>Alérgenos</label>
                        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:6px">
                            @foreach (var alergeno in _alergenos)
                            {
                                <label style="display:flex;align-items:center;gap:5px;cursor:pointer;
                                              padding:4px 10px;border-radius:20px;font-size:13px;
                                              border:1px solid var(--border);
                                              background:@(_form.AlergenoIds.Contains(alergeno.Id) ? "var(--accent-bg, #1a2a1a)" : "var(--surface2)")">
                                    <input type="checkbox"
                                           checked="@_form.AlergenoIds.Contains(alergeno.Id)"
                                           @onchange="e => ToggleAlergeno(alergeno.Id, (bool)e.Value!)"
                                           style="accent-color:var(--accent)"/>
                                    <span>@alergeno.Emoji @alergeno.Nombre</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <!-- Imagen (solo disponible al editar un producto ya existente) -->
                @if (_editandoId.HasValue)
                {
                    <div class="form-group">
                        <label>Imagen</label>
                        <div style="display:flex;align-items:center;gap:12px;margin-top:6px">
                            @if (!string.IsNullOrEmpty(_form.ImagenUrl))
                            {
                                <img src="@_form.ImagenUrl" alt="Vista previa"
                                     style="width:64px;height:64px;object-fit:cover;border-radius:10px;border:1px solid var(--border)"/>
                            }
                            else
                            {
                                <div style="width:64px;height:64px;border-radius:10px;border:1px dashed var(--border);
                                            display:flex;align-items:center;justify-content:center;font-size:24px">
                                    📷
                                </div>
                            }
                            <div style="flex:1">
                                <InputFile OnChange="OnImagenSeleccionada" accept=".jpg,.jpeg,.png,.webp"
                                           style="display:block;font-size:13px;margin-bottom:6px"/>
                                @if (_imagenArchivo is not null)
                                {
                                    <button class="btn-secondary" style="font-size:12px;padding:4px 12px"
                                            @onclick="SubirImagen" disabled="@_subiendoImagen">
                                        @(_subiendoImagen ? "Subiendo..." : "⬆ Subir imagen")
                                    </button>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_errorImagen))
                        {
                            <p style="color:var(--red);font-size:12px;margin-top:4px">⚠️ @_errorImagen</p>
                        }
                        <p style="color:var(--muted);font-size:11px;margin-top:4px">JPG, PNG o WebP · máx. 5 MB</p>
                    </div>
                }
                else
                {
                    <p style="color:var(--muted);font-size:12px;margin-top:8px">
                        💡 Guarda el producto primero y luego podrás subir una imagen.
                    </p>
                }

                @if (!string.IsNullOrEmpty(_errorModal))
                {
                    <p style="color:var(--red);font-size:13px;margin-top:8px">⚠️ @_errorModal</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button class="btn-primary" @onclick="GuardarProducto" disabled="@_guardando">
                    @(_guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductoDto>  _productos  = new();
    private List<CategoriaDto> _categorias = new();
    private List<AlergenoDto>  _alergenos  = new();
    private string  _busqueda        = string.Empty;
    private string  _categoriaFiltro = string.Empty;
    private bool    _mostrarOcultos  = false;
    private bool    _mostrarModal    = false;
    private bool    _guardando       = false;
    private int?    _editandoId;
    private string  _errorModal      = string.Empty;

    // Imagen
    private IBrowserFile? _imagenArchivo;
    private bool          _subiendoImagen = false;
    private string        _errorImagen    = string.Empty;

    private ProductoForm _form = new();

    private IEnumerable<ProductoDto> ProductosFiltrados =>
        _productos
            .Where(p => _mostrarOcultos || p.Activo)
            .Where(p => string.IsNullOrEmpty(_busqueda) ||
                        p.Nombre.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            .Where(p => string.IsNullOrEmpty(_categoriaFiltro) || p.CategoriaNombre == _categoriaFiltro);

    protected override async Task OnInitializedAsync()
    {
        _categorias = await Api.GetCategoriasAsync();
        _productos  = await Api.GetProductosAsync();
        _alergenos  = await Api.GetAlergenosAsync();
    }

    private void AbrirNuevoProducto()
    {
        _editandoId     = null;
        _form           = new ProductoForm { CategoriaId = _categorias.FirstOrDefault()?.Id ?? 1 };
        _errorModal     = string.Empty;
        _imagenArchivo  = null;
        _errorImagen    = string.Empty;
        _mostrarModal   = true;
    }

    private void AbrirEditar(ProductoDto p)
    {
        _editandoId = p.Id;
        _form = new ProductoForm
        {
            Nombre             = p.Nombre,
            Descripcion        = p.Descripcion,
            Precio             = p.Precio,
            Stock              = p.Stock,
            CategoriaId        = p.CategoriaId,
            ImagenUrl          = p.ImagenUrl,
            AlergenoIds        = p.Alergenos.Select(a => a.Id).ToList(),
            ComponenteDesayuno = p.ComponenteDesayuno
        };
        _errorModal    = string.Empty;
        _imagenArchivo = null;
        _errorImagen   = string.Empty;
        _mostrarModal  = true;
    }

    private void ToggleAlergeno(int alergenoId, bool isChecked)
    {
        if (isChecked)
        {
            if (!_form.AlergenoIds.Contains(alergenoId))
                _form.AlergenoIds.Add(alergenoId);
        }
        else
        {
            _form.AlergenoIds.Remove(alergenoId);
        }
    }

    private async Task GuardarProducto()
    {
        if (string.IsNullOrWhiteSpace(_form.Nombre))
        {
            _errorModal = "El nombre es obligatorio.";
            return;
        }
        if (_categorias.Count == 0)
        {
            _errorModal = "Crea al menos una categoría antes de añadir productos.";
            return;
        }

        _guardando  = true;
        _errorModal = string.Empty;

        var req = new CrearProductoRequest(_form.Nombre, _form.Descripcion,
            _form.Precio, _form.Stock, _form.CategoriaId, _form.ImagenUrl, _form.AlergenoIds,
            _form.ComponenteDesayuno);

        bool ok = _editandoId.HasValue
            ? await Api.ActualizarProductoAsync(_editandoId.Value, req)
            : await Api.CrearProductoAsync(req);

        _guardando = false;

        if (!ok) { _errorModal = "Error al guardar. Comprueba los datos e inténtalo de nuevo."; return; }

        _productos    = await Api.GetProductosAsync();
        _mostrarModal = false;
    }

    private void OnImagenSeleccionada(InputFileChangeEventArgs e)
    {
        _imagenArchivo = e.File;
        _errorImagen   = string.Empty;
    }

    private async Task SubirImagen()
    {
        if (_imagenArchivo is null || !_editandoId.HasValue) return;

        _subiendoImagen = true;
        _errorImagen    = string.Empty;

        var url = await Api.SubirImagenProductoAsync(_editandoId.Value, _imagenArchivo);

        _subiendoImagen = false;

        if (url is null)
        {
            _errorImagen = "Error al subir la imagen. Comprueba el formato y el tamaño (máx. 5 MB).";
            return;
        }

        _form.ImagenUrl = url;
        _imagenArchivo  = null;
        _productos = await Api.GetProductosAsync();
    }

    private async Task ActualizarStock(int id, int nuevoStock)
    {
        await Api.ActualizarStockAsync(id, nuevoStock);
        _productos = await Api.GetProductosAsync();
    }

    private async Task ToggleActivo(int id)
    {
        await Api.ToggleActivoAsync(id);
        _productos = await Api.GetProductosAsync();
    }

    private async Task ConfirmarEliminar(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar este producto? Esta acción no se puede deshacer."))
            return;
        await Api.EliminarProductoAsync(id);
        _productos = await Api.GetProductosAsync();
    }

    private void CerrarModal() => _mostrarModal = false;

    private static string GetStockClass(int stock) => stock switch
    {
        0      => "fill--empty",
        <= 5   => "fill--low",
        <= 15  => "fill--mid",
        _      => "fill--high"
    };

    private static int GetStockPercent(int stock) => Math.Min(100, stock * 5);

    private class ProductoForm
    {
        public string             Nombre             { get; set; } = string.Empty;
        public string             Descripcion        { get; set; } = string.Empty;
        public decimal            Precio             { get; set; }
        public int                Stock              { get; set; } = -1;
        public int                CategoriaId        { get; set; }
        public string?            ImagenUrl          { get; set; }
        public List<int>          AlergenoIds        { get; set; } = new();
        public ComponenteDesayuno ComponenteDesayuno { get; set; } = ComponenteDesayuno.Ninguno;
    }
}
