@page "/ingredientes"
@inject AdminApiService Api

<PageTitle>Ingredientes · CaféIES Admin</PageTitle>

<div class="page-header">
    <h1>Ingredientes</h1>
    <button class="btn-primary" @onclick="AbrirNuevo">+ Nuevo ingrediente</button>
</div>

<div class="table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Emoji</th>
                <th>Nombre</th>
                <th>Precio extra</th>
                <th>Stock</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ing in _ingredientes)
            {
                <tr style="opacity: @(ing.Activo ? "1" : "0.5")">
                    <td><span style="font-size:22px">@ing.Emoji</span></td>
                    <td><strong>@ing.Nombre</strong></td>
                    <td>@(ing.PrecioExtra > 0 ? $"+{ing.PrecioExtra:F2}€" : "—")</td>
                    <td>@(ing.Stock == -1 ? "∞ ilimitado" : $"{ing.Stock} uds.")</td>
                    <td>
                        <span class="badge @(ing.Activo ? "badge--green" : "badge--muted")">
                            @(ing.Activo ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        <div class="action-buttons">
                            <button class="btn-icon" title="Editar"
                                    @onclick="() => AbrirEditar(ing)">✏️</button>
                            <button class="btn-icon" title="@(ing.Activo ? "Desactivar" : "Activar")"
                                    @onclick="() => ToggleActivo(ing)">
                                @(ing.Activo ? "🔕" : "✅")
                            </button>
                            <button class="btn-icon btn-icon--danger" title="Eliminar"
                                    @onclick="() => ConfirmarEliminar(ing)">🗑</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_confirmarEliminar && _ingEliminar is not null)
{
    <div class="modal-overlay" @onclick="CancelarEliminar">
        <div class="modal" @onclick:stopPropagation="true" style="max-width:420px">
            <div class="modal-header">
                <h3>Confirmar eliminación</h3>
                <button class="modal-close" @onclick="CancelarEliminar">✕</button>
            </div>
            <div class="modal-body">
                <p>¿Eliminar el ingrediente <strong>@_ingEliminar.Emoji @_ingEliminar.Nombre</strong>?</p>
                <p style="color:var(--muted);font-size:13px">
                    No se puede eliminar si está asignado a algún producto.
                </p>
                @if (!string.IsNullOrEmpty(_errorEliminar))
                {
                    <p style="color:var(--red);font-size:13px;margin-top:8px">⚠️ @_errorEliminar</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                <button class="btn-primary" style="background:var(--red)"
                        @onclick="EliminarIngrediente" disabled="@_eliminando">
                    @(_eliminando ? "Eliminando..." : "Eliminar")
                </button>
            </div>
        </div>
    </div>
}

@if (_mostrarModal)
{
    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>@(_editandoId.HasValue ? "Editar ingrediente" : "Nuevo ingrediente")</h3>
                <button class="modal-close" @onclick="CerrarModal">✕</button>
            </div>
            <div class="modal-body">
                <div class="form-row">
                    <div class="form-group" style="flex:0 0 80px">
                        <label>Emoji</label>
                        <input class="form-input" @bind="_emoji" placeholder="🧅" maxlength="4"/>
                    </div>
                    <div class="form-group">
                        <label>Nombre *</label>
                        <input class="form-input" @bind="_nombre" placeholder="ej. Cebolla caramelizada"/>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Precio extra (€)</label>
                        <input class="form-input" type="number" step="0.01" min="0" max="9999"
                               @bind="_precioExtra" placeholder="0.00"/>
                    </div>
                    <div class="form-group">
                        <label>Stock (-1 = ilimitado)</label>
                        <input class="form-input" type="number" min="-1"
                               @bind="_stock" placeholder="-1"/>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p style="color:var(--red);font-size:13px;margin-top:8px">⚠️ @_error</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-secondary" @onclick="CerrarModal">Cancelar</button>
                <button class="btn-primary" @onclick="Guardar" disabled="@_guardando">
                    @(_guardando ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<IngredienteDto> _ingredientes = new();
    private bool   _mostrarModal   = false;
    private bool   _guardando      = false;
    private bool   _confirmarEliminar = false;
    private bool   _eliminando     = false;
    private int?   _editandoId;
    private string _nombre         = string.Empty;
    private string _emoji          = string.Empty;
    private decimal _precioExtra   = 0;
    private int    _stock          = -1;
    private string _error          = string.Empty;
    private string _errorEliminar  = string.Empty;
    private IngredienteDto? _ingEliminar;

    protected override async Task OnInitializedAsync()
        => _ingredientes = await Api.GetIngredientesAsync();

    private void AbrirNuevo()
    {
        _editandoId  = null;
        _nombre      = string.Empty;
        _emoji       = string.Empty;
        _precioExtra = 0;
        _stock       = -1;
        _error       = string.Empty;
        _mostrarModal = true;
    }

    private void AbrirEditar(IngredienteDto ing)
    {
        _editandoId  = ing.Id;
        _nombre      = ing.Nombre;
        _emoji       = ing.Emoji;
        _precioExtra = ing.PrecioExtra;
        _stock       = ing.Stock;
        _error       = string.Empty;
        _mostrarModal = true;
    }

    private async Task Guardar()
    {
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            _error = "El nombre es obligatorio.";
            return;
        }
        if (_stock < -1)
        {
            _error = "El stock no puede ser menor que -1.";
            return;
        }

        _guardando = true;
        _error     = string.Empty;

        var req = new CrearIngredienteRequest(
            _nombre.Trim(), _emoji.Trim(), _precioExtra, _stock);

        bool ok = _editandoId.HasValue
            ? await Api.ActualizarIngredienteAsync(_editandoId.Value, req)
            : await Api.CrearIngredienteAsync(req);

        _guardando = false;

        if (!ok) { _error = "Error al guardar. Inténtalo de nuevo."; return; }

        _ingredientes = await Api.GetIngredientesAsync();
        _mostrarModal = false;
    }

    private async Task ToggleActivo(IngredienteDto ing)
    {
        await Api.ToggleActivoIngredienteAsync(ing.Id);
        _ingredientes = await Api.GetIngredientesAsync();
    }

    private void ConfirmarEliminar(IngredienteDto ing)
    {
        _ingEliminar     = ing;
        _errorEliminar   = string.Empty;
        _confirmarEliminar = true;
    }

    private void CancelarEliminar()
    {
        _confirmarEliminar = false;
        _ingEliminar       = null;
        _errorEliminar     = string.Empty;
    }

    private async Task EliminarIngrediente()
    {
        if (_ingEliminar is null) return;
        _eliminando    = true;
        _errorEliminar = string.Empty;

        var (ok, error) = await Api.EliminarIngredienteAsync(_ingEliminar.Id);
        _eliminando = false;

        if (!ok)
        {
            _errorEliminar = error ?? "Error al eliminar.";
            return;
        }

        _ingredientes      = await Api.GetIngredientesAsync();
        _confirmarEliminar = false;
        _ingEliminar       = null;
    }

    private void CerrarModal() => _mostrarModal = false;
}
