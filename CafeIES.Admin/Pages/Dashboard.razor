@page "/"
@implements IAsyncDisposable
@inject AdminApiService Api
@inject NavigationManager Nav
@inject AuthAdminService Auth
@using Microsoft.AspNetCore.SignalR.Client

<PageTitle>Dashboard · CaféIES Admin</PageTitle>

@if (!_cargado)
{
    <div class="loading-wrap">
        <div class="spinner"></div>
        <p>Cargando...</p>
    </div>
}
else if (_dashboard is null)
{
    <p class="error-msg">Error al cargar el dashboard.</p>
}
else
{
    <div class="page-header">
        <div>
            <h1>Dashboard</h1>
            <span class="page-sub">Hoy, @DateTime.Now.ToString("dddd d MMMM")</span>
        </div>
        <select class="filter-select" @onchange="OnInstitutoChanged">
            <option value="">Todos los institutos</option>
            @foreach (var i in _institutos)
            {
                <option value="@i.Id" selected="@(i.Id == _institutoFiltro)">@i.Nombre</option>
            }
        </select>
    </div>

    <!-- ── Stats ──────────────────────────────────────────────────────────── -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">PEDIDOS HOY</div>
            <div class="stat-value">@_dashboard.PedidosHoy</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">INGRESOS HOY</div>
            <div class="stat-value">@_dashboard.IngresosHoy.ToString("F2")€</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">PRODUCTOS ACTIVOS</div>
            <div class="stat-value">@_dashboard.ProductosActivos</div>
            @if (_dashboard.ProductosStockBajo > 0)
            {
                <div class="stat-warning">⚠️ @_dashboard.ProductosStockBajo con stock bajo</div>
            }
        </div>
        <div class="stat-card @(_dashboard.AlumnosPendientes > 0 ? "stat-card--alert" : "")">
            <div class="stat-label">ALUMNOS PENDIENTES</div>
            <div class="stat-value">@_dashboard.AlumnosPendientes</div>
            @if (_dashboard.AlumnosPendientes > 0)
            {
                <a href="/usuarios" class="stat-link">Revisar →</a>
            }
        </div>
    </div>

    <!-- ── Pedidos en curso (tiempo real) ────────────────────────────────── -->
    <div class="section">
        <div class="section-header">
            <h2>Pedidos en curso</h2>
            <span class="live-badge">● EN VIVO</span>
        </div>

        @if (!_dashboard.PedidosEnCurso.Any())
        {
            <div class="empty-state">
                <span class="empty-icon">✅</span>
                <p>Sin pedidos pendientes ahora mismo</p>
            </div>
        }
        else
        {
            <div class="orders-live-grid">
                @foreach (var pedido in _dashboard.PedidosEnCurso)
                {
                    <div class="order-live-card @GetEstadoClass(pedido.Estado)">
                        <div class="order-num">#@pedido.NumeroPedido.ToString("D3")</div>
                        <div class="order-info">
                            <div class="order-user">@pedido.UsuarioNombre</div>
                            @if (!string.IsNullOrEmpty(pedido.InstitutoNombre))
                            {
                                <div class="order-instituto">🏫 @pedido.InstitutoNombre</div>
                            }
                            <div class="order-items">
                                @string.Join(", ", pedido.Lineas.Select(l => $"{l.ProductoNombre} ×{l.Cantidad}"))
                            </div>
                            <div class="order-time">@pedido.FechaCreacion.ToString("HH:mm")</div>
                        </div>
                        <div class="order-actions">
                            @if (pedido.Estado == EstadoPedido.Pendiente)
                            {
                                <button class="btn-status btn-prep"
                                        @onclick="() => CambiarEstado(pedido.Id, EstadoPedido.EnPreparacion)">
                                    En preparación
                                </button>
                            }
                            else if (pedido.Estado == EstadoPedido.EnPreparacion)
                            {
                                <button class="btn-status btn-ready"
                                        @onclick="() => CambiarEstado(pedido.Id, EstadoPedido.Listo)">
                                    ✓ Listo
                                </button>
                            }
                        </div>
                        <div class="order-status-dot"></div>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private DashboardDto? _dashboard;
    private bool _cargado;
    private Timer? _timer;
    private HubConnection? _hubConnection;
    private List<InstitutoDto> _institutos = new();
    private int? _institutoFiltro;

    protected override async Task OnInitializedAsync()
    {
        _institutos = await Api.GetInstitutosAsync();
        _dashboard  = await Api.GetDashboardAsync(_institutoFiltro);
        _cargado    = true;

        // FIX-18: Conectar a SignalR para recibir NuevoPedido en tiempo real
        await ConectarSignalRAsync();

        // Timer como fallback cada 60s (antes era 30s)
        _timer = new Timer(async _ =>
        {
            try
            {
                _dashboard = await Api.GetDashboardAsync(_institutoFiltro);
                await InvokeAsync(StateHasChanged);
            }
            catch { /* ignorar errores de red en auto-refresh */ }
        }, null, TimeSpan.FromSeconds(60), TimeSpan.FromSeconds(60));
    }

    private async Task ConectarSignalRAsync()
    {
        try
        {
            var baseUrl = Nav.BaseUri.TrimEnd('/');
            // Obtener la URL de la API del HttpClient configurado
            var apiBaseUrl = Api.GetApiBaseUrl();
            if (string.IsNullOrEmpty(apiBaseUrl)) return;

            _hubConnection = new HubConnectionBuilder()
                .WithUrl($"{apiBaseUrl}hubs/cafeteria", options =>
                {
                    options.AccessTokenProvider = () => Task.FromResult(Auth.Token);
                })
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<object>("NuevoPedido", async _ =>
            {
                _dashboard = await Api.GetDashboardAsync(_institutoFiltro);
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch { /* SignalR no disponible — el timer de fallback se encarga */ }
    }

    private async Task OnInstitutoChanged(ChangeEventArgs e)
    {
        _institutoFiltro = int.TryParse(e.Value?.ToString(), out var id) ? id : null;
        _dashboard = await Api.GetDashboardAsync(_institutoFiltro);
    }

    private async Task CambiarEstado(int pedidoId, EstadoPedido nuevoEstado)
    {
        await Api.CambiarEstadoPedidoAsync(pedidoId, nuevoEstado);
        _dashboard = await Api.GetDashboardAsync(_institutoFiltro);
    }

    private static string GetEstadoClass(EstadoPedido estado) => estado switch
    {
        EstadoPedido.Pendiente     => "order--new",
        EstadoPedido.EnPreparacion => "order--prep",
        EstadoPedido.Listo         => "order--ready",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        _timer?.Dispose();
        if (_hubConnection is not null)
            await _hubConnection.DisposeAsync();
    }
}
