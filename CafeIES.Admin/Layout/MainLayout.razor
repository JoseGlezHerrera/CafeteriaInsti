@inherits LayoutComponentBase
@implements IDisposable
@using CafeIES.Admin.Services
@inject AuthAdminService Auth
@inject AdminApiService Api
@inject NavigationManager Nav

<div class="admin-layout">

    @if (_inicializando)
    {
        <div class="loading-wrap"><div class="spinner"></div></div>
    }
    else if (Auth.EstaAutenticado)
    {
        <!-- ── Sidebar ─────────────────────────────────────────────────── -->
        <aside class="sidebar">
            <div class="sidebar-logo">
                Café<span class="accent">IES</span>
                <span class="sidebar-admin-label">ADMIN</span>
            </div>

            <nav class="sidebar-nav">
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-item">
                    <span class="nav-icon">📊</span> Dashboard
                </NavLink>
                <NavLink href="/productos" class="nav-item">
                    <span class="nav-icon">🍽️</span> Productos
                </NavLink>
                <NavLink href="/categorias" class="nav-item">
                    <span class="nav-icon">🗂️</span> Categorías
                </NavLink>
                <NavLink href="/pedidos" class="nav-item">
                    <span class="nav-icon">🧾</span> Pedidos
                </NavLink>
                <NavLink href="/usuarios" class="nav-item">
                    <span class="nav-icon">👥</span> Usuarios
                    @if (pendingCount > 0)
                    {
                        <span class="badge-red">@pendingCount</span>
                    }
                </NavLink>
                <NavLink href="/invitaciones" class="nav-item">
                    <span class="nav-icon">🔗</span> Invitaciones
                </NavLink>
                <NavLink href="/institutos" class="nav-item">
                    <span class="nav-icon">🏫</span> Institutos
                </NavLink>
                <NavLink href="/horarios" class="nav-item">
                    <span class="nav-icon">⏰</span> Horarios
                </NavLink>
                <NavLink href="/reportes" class="nav-item">
                    <span class="nav-icon">📈</span> Reportes
                </NavLink>
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="user-avatar-sm">👤</div>
                    <div>
                        <div class="user-name">@Auth.NombreUsuario</div>
                        <div class="sidebar-role">Administrador</div>
                    </div>
                </div>
                <button class="logout-btn" @onclick="CerrarSesion">Salir</button>
            </div>
        </aside>

        <!-- ── Contenido ──────────────────────────────────────────────── -->
        <main class="admin-main">
            @Body
        </main>
    }

    </div>

@code {
    private int  pendingCount   = 0;
    private bool _inicializando = true;

    protected override async Task OnInitializedAsync()
    {
        await Auth.RestaurarSesionAsync();
        _inicializando = false;

        if (!Auth.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        pendingCount = await Api.GetPendientesCountAsync();
        Nav.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!Auth.EstaAutenticado) return;
        pendingCount = await Api.GetPendientesCountAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CerrarSesion()
    {
        await Auth.LogoutAsync();
        Nav.LocationChanged -= OnLocationChanged;
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
