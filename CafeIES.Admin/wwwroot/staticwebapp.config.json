{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_framework/*", "/css/*", "*.{png,jpg,gif,ico,webp,svg,woff,woff2}"]
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".dll":  "application/octet-stream",
    ".dat":  "application/octet-stream"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache"
  }
}
